---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";

export interface SchemaObject {
  [key: string]: unknown;
}

export interface Props {
  /** Page title — pattern: "Page — Keyword-Rich Brand Context" */
  title: string;
  /** Meta description, 140–160 chars, benefit + keyword led. */
  description: string;
  /** Path-absolute OG image, e.g. "/og/results.png" */
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  keywords?: string;
  /** Page-specific JSON-LD (BreadcrumbList, FAQPage, ItemList …). WebSite + Organization are added automatically. */
  schema?: SchemaObject[];
}

const {
  title,
  description,
  ogImage = "/og/default.png",
  ogType = "website",
  noindex = false,
  keywords,
  schema = [],
} = Astro.props;

const SITE_URL = Astro.site ?? new URL("https://yarrwin.com");

/* Canonical always carries a trailing slash to match sitemap + build format. */
const normalizedPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "") + "/";
const canonical = new URL(normalizedPath, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

/**
 * Automated JSON-LD: WebSite + Organization ship on every page,
 * merged with any page-specific schemas passed via props.
 */
const schemas: SchemaObject[] = [
  ...schema,
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL.href}#website`,
    name: "Yarrwin",
    /* Brand entity variants — helps Google reconcile the keyword cluster
       (yarrwin / yarrwin game / yarrwin lottery / yarrwin club) to one entity. */
    alternateName: ["Yarrwin Official", "Yarrwin Game", "Yarrwin Lottery", "Yarrwin Club"],
    url: SITE_URL.href,
    description:
      "Yarrwin is a lightning-fast online gaming and lottery results platform featuring WinGo colour prediction, K3 and 5D lotteries with transparent, verifiable mechanics.",
    inLanguage: "en",
    publisher: {
      "@type": "Organization",
      "@id": `${SITE_URL.href}#organization`,
      name: "Yarrwin",
      url: SITE_URL.href,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_URL.href}#organization`,
    name: "Yarrwin",
    alternateName: "yarrwin.com",
    url: SITE_URL.href,
    logo: {
      "@type": "ImageObject",
      url: new URL("/og/default.png", SITE_URL).href,
      width: 1200,
      height: 630,
    },
    description:
      "Yarrwin operates a premium online gaming and lottery results platform: instant WinGo, K3 and 5D results with a permanent public archive.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04070d" />

    <!-- Icons & sitemap -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="Yarrwin" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Yarrwin — lightning-fast online gaming & lottery results platform" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yarrwin" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Yarrwin — lightning-fast online gaming & lottery results platform" />

    <!-- Fonts (preconnected, swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Sora:wght@600;700;800&display=swap"
    />

    <!-- Structured data -->
    <JsonLd data={schemas} />
  </head>
  <body class="flex min-h-screen flex-col pt-[76px]">
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
