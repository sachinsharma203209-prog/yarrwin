---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";

export interface SchemaObject {
  [key: string]: unknown;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  jsonLd?: SchemaObject[];
  noindex?: boolean;
  keywords?: string;
  schema?: SchemaObject[];
}

const {
  title,
  description,
  canonical: canonicalProp,
  image,
  type = "website",
  robots,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  noindex = false,
  keywords,
  schema = [],
} = Astro.props;

const SITE_URL = Astro.site ?? new URL("https://yarrwin.online");

const normalizedPath =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/+$/, "") + "/";
const canonical = canonicalProp ?? new URL(normalizedPath, SITE_URL).href;
const ogImage = image ?? "/og/default.png";
const ogImageUrl = new URL(ogImage, SITE_URL).href;
const robotsContent = noindex
  ? "noindex, nofollow"
  : robots ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const allSchemas: SchemaObject[] = [
  ...schema,
  ...(jsonLd ? [jsonLd] : []),
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL.href}#website`,
    name: "Yarrwin",
    alternateName: "yarrwin.online",
    url: SITE_URL.href,
    description:
      "Yarrwin — online gaming and lottery results platform with draw results, gaming strategies and winner stories.",
    inLanguage: "en",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04070d" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="Yarrwin" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Yarrwin — Online Gaming &amp; Lottery Results" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yarrwin" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Yarrwin — Online Gaming &amp; Lottery Results" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Sora:wght@600;700;800&display=swap"
    />

    <JsonLd data={allSchemas} />
  </head>
  <body class="flex min-h-screen flex-col pt-[76px]">
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
