---
interface Props {
  title: string;
  active?: string;
}

const { title, active } = Astro.props;

const navLinks = [
  { label: 'Dashboard', icon: '📊', href: '/admin', id: 'dashboard' },
  { label: 'Posts', icon: '📝', href: '/admin/posts', id: 'posts' },
  { label: 'Add New Post', icon: '➕', href: '/admin/posts/new', id: 'posts-new' },
  { label: 'Categories', icon: '📁', href: '/admin/categories', id: 'categories' },
  { label: 'Media Library', icon: '🖼', href: '/admin/media', id: 'media' },
  { label: 'Site Settings', icon: '⚙', href: '/admin/settings', id: 'settings' },
  { label: 'View Website', icon: '🌐', href: '/', id: 'view-site', external: true },
  { label: 'Logout', icon: '🚪', href: '/admin/logout', id: 'logout' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Yarrwin Admin</title>
    <style is:global>
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      :root{
        --bg:#04070d;--sidebar:#0a0f1a;--card:#0e1626;
        --border:rgba(255,255,255,0.08);--text:#d7deeb;--text-dim:#8797b3;
        --accent:#00d68f;--danger:#ff4d5e;--white:#eef2f9;
      }
      html{min-height:100%;overflow-x:hidden}
      body{
        min-height:100vh;overflow-x:hidden;overflow-y:auto;
        font-family:"Inter",ui-sans-serif,system-ui,sans-serif;
        background:var(--bg);color:var(--text);
        background-image:radial-gradient(900px 600px at 80% -10%,rgb(0 214 143 / 0.05),transparent 60%);
      }
      a{color:var(--accent);text-decoration:none}

      /* Sidebar */
      .sidebar{
        position:fixed;top:0;left:0;bottom:0;width:260px;
        background:var(--sidebar);border-right:1px solid var(--border);
        display:flex;flex-direction:column;z-index:100;
        transition:transform .25s ease;
      }
      .sidebar-brand{
        padding:20px 24px;display:flex;align-items:center;gap:10px;
        border-bottom:1px solid var(--border);
      }
      .sidebar-brand h1{
        font-size:17px;font-weight:800;color:var(--white);
        font-family:"Sora",sans-serif;letter-spacing:-.02em;
      }
      .sidebar-brand .dot{
        width:8px;height:8px;border-radius:50%;background:var(--accent);
        display:inline-block;animation:pulse 2s ease-in-out infinite;
      }
      @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

      .sidebar-nav{flex:1;overflow-y:auto;padding:12px 0}
      .sidebar-nav a{
        display:flex;align-items:center;gap:12px;
        padding:10px 24px;font-size:14px;font-weight:500;
        color:var(--text-dim);transition:all .15s;
        border-left:3px solid transparent;
      }
      .sidebar-nav a:hover{
        color:var(--white);background:rgb(255 255 255 / 0.04);
      }
      .sidebar-nav a.active{
        color:var(--accent);background:rgb(0 214 143 / 0.06);
        border-left-color:var(--accent);font-weight:600;
      }
      .sidebar-nav a .icon{font-size:16px;width:22px;text-align:center;flex-shrink:0}

      .sidebar-footer{
        padding:16px 24px;border-top:1px solid var(--border);
        font-size:12px;color:var(--text-dim);
      }

      /* Top header */
      .topbar{
        position:fixed;top:0;left:260px;right:0;height:60px;
        background:rgb(4 7 13 / 0.85);backdrop-filter:blur(12px);
        border-bottom:1px solid var(--border);
        display:flex;align-items:center;justify-content:space-between;
        padding:0 28px;z-index:90;
      }
      .topbar-title{
        font-size:16px;font-weight:700;color:var(--white);
        font-family:"Sora",sans-serif;
      }
      .topbar-right{display:flex;align-items:center;gap:16px}
      .topbar-user{font-size:13px;color:var(--text-dim)}
      .topbar-logout{
        background:rgb(255 77 94 / 0.1);color:var(--danger);
        border:1px solid rgb(255 77 94 / 0.25);border-radius:8px;
        padding:6px 14px;font-size:12px;font-weight:600;cursor:pointer;
        font-family:inherit;transition:all .15s;
      }
      .topbar-logout:hover{background:rgb(255 77 94 / 0.2)}

      /* Main content */
      .main{
        margin-left:260px;padding:84px 28px 40px;
        min-height:100vh;min-width:0;
      }
      .main > *{width:100%;max-width:1280px;margin-inline:auto}

      /* Hamburger (mobile) */
      .hamburger{
        display:none;position:fixed;top:14px;left:16px;z-index:200;
        background:var(--sidebar);border:1px solid var(--border);
        border-radius:10px;padding:8px 10px;cursor:pointer;
        color:var(--text);font-size:18px;line-height:1;
      }
      .overlay{
        display:none;position:fixed;inset:0;background:rgb(0 0 0 / 0.6);
        z-index:95;
      }

      @media(max-width:768px){
        .sidebar{transform:translateX(-100%)}
        .sidebar.open{transform:translateX(0)}
        .overlay.open{display:block}
        .topbar{left:0;padding:0 16px 0 64px}
        .main{margin-left:0;padding:70px 16px 32px}
        .hamburger{display:block}
        .topbar-user{display:none}
      }
    </style>
  </head>
  <body>
    <!-- Mobile hamburger -->
    <button class="hamburger" id="hamburgerBtn" aria-label="Toggle menu">☰</button>
    <div class="overlay" id="overlay"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="dot"></span>
        <h1>Yarrwin</h1>
      </div>
      <nav class="sidebar-nav">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[active === link.id && 'active']}
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            data-nav-id={link.id}
          >
            <span class="icon">{link.icon}</span>
            <span>{link.label}</span>
          </a>
        ))}
      </nav>
      <div class="sidebar-footer">Yarrwin CMS v1.0</div>
    </aside>

    <!-- Top header -->
    <header class="topbar">
      <span class="topbar-title">{title}</span>
      <div class="topbar-right">
        <span class="topbar-user" id="topbarUser"></span>
        <button class="topbar-logout" id="logoutBtn">Logout</button>
      </div>
    </header>

    <!-- Main content -->
    <main class="main">
      <slot />
    </main>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('overlay');
        const hamburger = document.getElementById('hamburgerBtn');

        if (hamburger && sidebar && overlay) {
          hamburger.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('open');
          });
          overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('open');
          });
        }

        const logoutBtn = document.getElementById('logoutBtn');
        if (logoutBtn) {
          logoutBtn.addEventListener('click', async () => {
            try {
              await fetch('/api/auth/logout', { method: 'POST' });
            } catch (_) {}
            window.location.href = '/admin/login';
          });
        }

        // Highlight active nav link
        const currentPath = window.location.pathname.replace(/\/+$/, '') || '/admin';
        document.querySelectorAll('.sidebar-nav a[data-nav-id]').forEach(a => {
          if (a.getAttribute('data-nav-id') === 'logout') return;
          const href = a.getAttribute('href').replace(/\/+$/, '') || '/admin';
          if (href === '/admin' && currentPath === '/admin') {
            a.classList.add('active');
          } else if (href !== '/admin' && currentPath.startsWith(href)) {
            a.classList.add('active');
          }
        });
      });
    </script>
  </body>
</html>
