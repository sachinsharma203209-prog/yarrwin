---
import ExpandedGuide from "./ExpandedGuide.astro";

interface Props { kind: string; }
const { kind } = Astro.props;
const data: Record<string, { path: string; label: string; heading: string; title: string; description: string; keyword: string; topic: string; focuses: string[] }> = {
  wingo: { path: "/games/wingo/", label: "WinGo guide", heading: "Yarrwin WinGo Guide: Rules, Colours and Results Explained", title: "Yarrwin WinGo Guide | Colours, Rules and Results", description: "Understand WinGo terminology, colour and number selections, round records, probability and safer play without prediction claims.", keyword: "Yarrwin WinGo", topic: "WinGo colour and number game", focuses: ["WinGo names a colour and number game category described in the existing Games Hub.","Colour labels such as red, green or violet must be checked against the current rule screen.","A round or period is an identifier for one recorded outcome, not a promise about the next one.","Number, size or parity labels should be read from the rules instead of guessed from a screenshot.","A hypothetical round can explain format, but it cannot predict a real outcome.","Previous rows describe history; they do not change the probability of a future independent round.","A predictor, signal group or hack download cannot turn uncertainty into a guarantee.","A results page helps you compare fields, while an account page controls any action.","Keep a budget and time limit before reading a game page or considering play.","Use the Games Hub, results guide and responsible-gaming page together."] },
  k3: { path: "/games/k3/", label: "K3 guide", heading: "Yarrwin K3 Guide: Dice Rules, Sums and Results", title: "Yarrwin K3 Guide | Dice Sums, Rules and Results", description: "Learn the K3 dice format, sums, parity, size labels, hypothetical examples and scam warnings without guaranteed predictions.", keyword: "Yarrwin K3", topic: "K3 three-dice game", focuses: ["K3 describes a three-dice game category listed in the existing Games Hub.","The current rules decide how each die, total and market label is displayed.","A round identifier connects a result row to one recorded dice outcome.","Sum, odd or even, and size labels should be interpreted from the platform’s rule wording.","A hypothetical dice combination is an explanation of format, never a forecast.","Earlier dice totals cannot make a later total more likely.","Prediction groups and guaranteed K3 signals are scam warnings.","Use the results guide to understand fields, not to chase a pattern.","Set a spending and time boundary before opening any game account.","The K3 guide works best beside the Games Hub and responsible-gaming guide."] },
  "5d": { path: "/games/5d/", label: "5D guide", heading: "Yarrwin 5D Guide: Five-Digit Rules and Results", title: "Yarrwin 5D Guide | Five-Digit Rules and Results", description: "Understand the Yarrwin 5D five-digit format, positions, totals, result records and prediction-scam risks.", keyword: "Yarrwin 5D", topic: "five-digit 5D game", focuses: ["5D refers to a five-digit result format covered by the existing Games Hub.","Each position should be read from the current rules rather than inferred from a post.","A period or round number lets readers identify one result record.","Totals and position markets apply only when the platform’s visible rules describe them.","A hypothetical five-digit string can show how positions are labelled without fabricating a live result.","A previous sequence cannot select the next five digits or improve a random guess.","Generators, predictors and paid signal channels offer no reliable shortcut.","Compare a result row with the relevant guide and timestamp before sharing it.","A budget and a stop time matter more than a longer history screen.","Link the 5D guide to the Games Hub, results page and safety guidance."] },
  aviator: { path: "/games/aviator/", label: "Aviator guide", heading: "Yarrwin Aviator Guide: Multipliers, Rounds and Risks", title: "Yarrwin Aviator Guide | Multipliers and Round Risks", description: "Learn the general Aviator crash-game format, multipliers, round records, uncertainty and predictor-scam warnings.", keyword: "Yarrwin Aviator", topic: "Aviator multiplier game", focuses: ["Aviator is presented in the existing Games Hub as a crash-style game category.","A multiplier describes the value displayed during a round; check the platform’s own wording.","A round begins, changes and ends according to the current game interface.","Manual or automatic cash-out concepts should be used only when visible in the platform rules.","A hypothetical multiplier explains a record format and says nothing about the next round.","Earlier multipliers cannot predict when a later round will end.","Signals, predictor apps and modified downloads are common scam warnings.","A history panel can describe distribution, but it cannot create certainty.","Use a fixed budget and session limit before considering any play.","Read the Aviator guide with the Games Hub and responsible-gaming page."] },
  results: { path: "/results/", label: "Results hub", heading: "Yarrwin Results Guide: WinGo, K3 and 5D Results", title: "Yarrwin Results Guide | WinGo, K3 and 5D", description: "Learn how to read Yarrwin game results, period identifiers, timestamps, history limits and missing-result warnings.", keyword: "Yarrwin results", topic: "game result records", focuses: ["A result is a record of an outcome displayed for a named game or round.","Period and round identifiers help distinguish one row from another.","Timestamps should be read with their stated timezone and source context.","Colour, number, dice or digit fields depend on the game’s published format.","History can help explain what a page records, but it is not a prediction tool.","A missing or delayed row needs a later check, not a guessed value.","Screenshots can be edited, so compare a result with the relevant source page.","Do not call a result live, permanent or verified unless the platform proves that status.","Keep result research separate from spending decisions and set personal limits.","Use the individual WinGo, K3 and 5D result guides for field-by-field context."] },
  "results-wingo": { path: "/results/wingo/", label: "WinGo results", heading: "WinGo Results Guide: Periods, Colours and History", title: "WinGo Results Guide | Periods, Colours and History", description: "Learn how to read WinGo result rows, period numbers, colours, timestamps, history limits and fake-result warnings.", keyword: "WinGo results", topic: "WinGo result records", focuses: ["A WinGo result row records the fields shown by the relevant results page.","The period number identifies the row and should be copied carefully.","Colour and number labels must match the visible rule wording.","A timestamp gives context only when its timezone and source are clear.","A hypothetical row may explain format, but it is not a live result.","Earlier colours do not predict the next colour or number.","Fake screenshots and predictor channels can alter or mislabel history.","If a row is missing, wait for a source update instead of inventing one.","Use the results page for reading and the game guide for rules.","Keep gambling decisions separate from historical-data browsing."] },
  "results-k3": { path: "/results/k3/", label: "K3 results", heading: "K3 Results Guide: Dice Rows, Sums and History", title: "K3 Results Guide | Dice Rows, Sums and History", description: "Understand K3 result rows, round identifiers, dice totals, timestamps, missing data and history limitations.", keyword: "K3 results", topic: "K3 result records", focuses: ["A K3 result row records the dice fields displayed for one round.","The round identifier separates one dice outcome from another.","Read each die and the total only as the source page labels them.","Odd, even, big or small categories need the current rule definition.","A hypothetical row explains layout and must never be presented as live data.","Earlier dice totals cannot forecast the next combination.","Edited screenshots and paid prediction groups are unreliable sources.","A delayed row should remain marked unknown until the source updates.","Use the K3 guide to understand rules and the results page to read fields.","Do not let a history table push you beyond a fixed personal limit."] },
  "results-5d": { path: "/results/5d/", label: "5D results", heading: "5D Results Guide: Digits, Positions and History", title: "5D Results Guide | Digits, Positions and History", description: "Learn how to read 5D result rows, digit positions, totals, timestamps and the limits of historical data.", keyword: "5D results", topic: "5D result records", focuses: ["A 5D result row records five digits in the format shown by the source.","The period number identifies which draw record a row belongs to.","Read positions from left to right only when the current rules define them that way.","A total or sum field should not be assumed when it is absent from the source.","A hypothetical row demonstrates structure and is not a fabricated live outcome.","Past digit sequences cannot choose the next five digits.","Fake result images and paid signals may hide altered or incomplete fields.","If data is delayed, record it as unavailable and check the source later.","Pair the 5D results guide with its game-rules guide before interpreting a row.","Set a time and spending boundary before browsing result history."] },
};
const item = data[kind] ?? data.results;
const scenarios = item.focuses;
const sectionTitles = kind === "wingo" ? ["Colour markets","Period labels","Number and size","Reading a round","History without patterns","Checking a result row","Prediction claims","Choosing a stopping point","Account boundaries","Where to continue"] : kind === "k3" ? ["Three dice at a glance","How totals are shown","Parity and size","Round identifiers","A worked format example","History is descriptive","Signals and shortcuts","Session boundaries","Record checking","Related reading"] : kind === "5d" ? ["Five positions","Period records","Position markets","Totals and labels","Illustrative strings","Past digits","Signal-channel warnings","Comparing sources","Personal limits","Next guides"] : kind === "aviator" ? ["Multiplier display","Round lifecycle","Cash-out wording","History panel","Hypothetical example","Uncertainty","Predictor scams","Session controls","Account checks","Further reading"] : kind === "results" ? ["What a result row contains","Identifiers and time","Game-specific fields","Missing records","Source comparison","Screenshots and edits","History limits","Responsible browsing","Choosing a guide","Summary"] : kind === "results-wingo" ? ["Find the period","Read colour fields","Check the number","Use the timestamp","Mark unknown rows","Compare the source","Ignore streak claims","Keep a record","Browse responsibly","Related rules"] : kind === "results-k3" ? ["Locate the round","Read each die","Verify the total","Interpret categories","Use timestamps","Handle missing rows","Reject edited history","Keep evidence","Set limits","Rules context"] : ["Locate the draw","Read five positions","Check the period","Understand optional totals","Use a hypothetical row","Do not forecast digits","Spot altered screenshots","Record unavailable data","Set a boundary","Rules and context"];
const faqs = [
  { q: `What are ${item.keyword}?`, a: `${item.keyword} are records or guidance for ${item.topic}; check the current platform page for exact availability and rules.` },
  { q: "Can past results predict the next outcome?", a: "No. History describes earlier records and cannot guarantee a future random outcome." },
  { q: "Are examples on this page live data?", a: "No. Any example is hypothetical and must not be treated as a live result." },
  { q: "How should I verify a result?", a: "Compare the row, identifier, timestamp and fields with the relevant source page." },
  { q: "Are predictor apps reliable?", a: "No reliable evidence supports guaranteed predictors; treat paid signals and hack downloads as scam warnings." },
  { q: "What if a result is missing?", a: "Leave it unknown, check again later and use a verified support route if the issue continues." },
  { q: "Can I use these guides to guarantee winnings?", a: "No. These pages explain formats and safety, not guaranteed strategies or returns." },
  { q: "Who should use this information?", a: "Adults aged 18+ where permitted, with a budget and an understanding of financial risk." },
];
---
<ExpandedGuide {...item} scenarios={scenarios} faqs={faqs} sectionTitles={sectionTitles} />
