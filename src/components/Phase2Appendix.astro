---
interface Props { topic:string; links:Array<{href:string;label:string}>; variant?:"games"|"results"|"howto" }
const raw = Astro.props as Props;
const topic = raw.topic;
const links = raw.links;
const variant = raw.variant ?? (topic.includes("results") ? "results" : topic.includes("how to play") ? "howto" : "games");
const sets = { games:{heads:["Choose a format","Read a market label","Treat a round as a record","Compare game families","Avoid prediction traps","Set a session boundary","Move to the rules"], notes:["The Games hub is a map, not a promise. WinGo, K3, 5D and Aviator use different labels, so open the matching guide before interpreting a button or table.","A colour, die, digit or multiplier means only what the current game screen defines. Write down the label and its surrounding rule instead of borrowing wording from another game."]}, results:{heads:["Locate the row","Read identifiers","Check the timestamp","Interpret fields by game","Mark gaps honestly","Reject altered screenshots","Use history with restraint"], notes:["A results table is useful when its game name, period and time remain visible together. If one field is missing, mark the row incomplete rather than reconstructing it from a group message.","WinGo colours, K3 dice and 5D positions are not interchangeable. The individual result guides explain each format while this hub helps you choose the right record."]}, howto:{heads:["Prepare before opening a game","Learn the screen","Make a small test","Read the outcome","Keep money separate","Recognise pressure","Stop and review"], notes:["A beginner benefits from observing the interface before making any decision. Check the rules, account state and available controls; do not assume a feature exists because another site mentions it.","Learning the sequence is more useful than memorising a tip: open the relevant page, identify the round, read the result and record what is still unknown."]}}[variant];
---
<section class="section-pad border-t border-white/5"><div class="container-site">{sets.heads.map((head,i)=><section class="mt-10 first:mt-0"><h2 class="font-display text-3xl font-extrabold tracking-tight text-mist-100">{head}</h2><h3 class="mt-5 font-display text-lg font-bold text-mist-100">{topic} in practice</h3><p class="mt-3 max-w-3xl leading-relaxed text-mist-300">{sets.notes[i%2]} {i%2===0 ? "Use the visible account page as the final reference and keep any example clearly hypothetical." : "A calm, reversible check is preferable to a rushed retry, paid signal or copied instruction."}</p><p class="mt-4 max-w-3xl leading-relaxed text-mist-300">For this section, note the source, time and exact wording. Protect passwords, OTPs, recovery phrases and payment details; if the evidence is incomplete, pause and return through a route you opened yourself.</p></section>)}<section class="mt-10"><h2 class="font-display text-3xl font-extrabold tracking-tight text-mist-100">Useful next pages</h2><p class="mt-3 max-w-3xl leading-relaxed text-mist-300">{links.slice(0,8).map((link,i)=><>{i>0 && ", "}<a href={link.href} class="prose-link">{link.label}</a></>)}.</p></section></div></section>
