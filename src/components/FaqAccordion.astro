---
import Icon from "./Icon.astro";

interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    items.map((item, i) => (
      <details id={`faq-${i + 1}`} class="faq-item glass rounded-2xl">
        <summary>
          <span class="pr-4">{item.q}</span>
          <Icon name="chevron-down" class="faq-chevron h-5 w-5 shrink-0 text-mist-400" />
        </summary>
        <p class="px-5 pb-5 text-sm leading-relaxed text-mist-400 md:px-6 md:pb-6">{item.a}</p>
      </details>
    ))
  }
</div>
