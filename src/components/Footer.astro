---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const year = new Date().getUTCFullYear();

const columns = [
  {
    title: "Games",
    links: [
      { href: "/games/", label: "All Games" },
      { href: "/games/#wingo", label: "WinGo" },
      { href: "/games/#k3", label: "K3 Lottery" },
      { href: "/games/#5d", label: "5D Lottery" },
    ],
  },
  {
    title: "Results",
    links: [
      { href: "/results/", label: "Live Results" },
      { href: "/results/#wingo", label: "WinGo Archive" },
      { href: "/results/#k3", label: "K3 Archive" },
      { href: "/results/#5d", label: "5D Archive" },
    ],
  },
  {
    title: "Learn",
    links: [
      { href: "/guide/how-to-play/", label: "Beginner Guide" },
      { href: "/blog/", label: "Blog" },
      { href: "/games/", label: "Strategy Guides" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy/", label: "Privacy Policy" },
      { href: "/terms/", label: "Terms of Service" },
    ],
  },
] as const;
---

<footer class="relative mt-8 border-t border-white/5 bg-ink-900/70">
  <div class="container-site py-14 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist-400">
          Yarrwin is an independent informational guide for online gaming and lottery
          results. Check draw results, read game guides and learn safe play practices.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="chip chip-neutral"><Icon name="eye" class="h-3.5 w-3.5" /> Draw results</span>
          <span class="chip chip-neutral"><Icon name="lock" class="h-3.5 w-3.5" /> Safe play guides</span>
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-mist-500">{col.title}</h3>
              <ul class="mt-4 flex flex-col gap-2.5">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-mist-300 transition hover:text-brand-300">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 space-y-4 border-t border-white/5 pt-6 text-xs leading-relaxed text-mist-500">
      <p>
        <strong class="text-mist-400">Disclaimer:</strong> Yarrwin is an independent informational
        resource. Gaming and lottery involve financial risk. Please play responsibly. This site
        is not affiliated with any game operator. Always verify results with official sources.
      </p>
      <p>
        <strong class="text-mist-400">Accuracy:</strong> We strive to keep all results and
        information current. Lottery draws and gaming platforms change regularly — always
        verify details on official sources before making decisions.
      </p>
      <p>&copy; {year} Yarrwin. All rights reserved. Yarrwin is an independent informational resource.</p>
    </div>
  </div>
</footer>
