---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

const year = new Date().getUTCFullYear();

const columns = [
  {
    title: "Platform",
    links: [
      { href: "/games/", label: "Games Hub" },
      { href: "/results/", label: "Results Archive" },
      { href: "/guide/how-to-play/", label: "How to Play" },
      { href: "/#faq", label: "FAQ" },
    ],
  },
  {
    title: "Games",
    links: [
      { href: "/games/#wingo", label: "WinGo — Colour Prediction" },
      { href: "/games/#k3", label: "K3 Lottery" },
      { href: "/games/#5d", label: "5D Lottery" },
      { href: "/games/#aviator", label: "Aviator & Slots" },
    ],
  },
  {
    title: "Results",
    links: [
      { href: "/results/#wingo", label: "WinGo Results" },
      { href: "/results/#k3", label: "K3 Results" },
      { href: "/results/#5d", label: "5D Results" },
      { href: "/results/", label: "Latest Draws" },
    ],
  },
  {
    title: "Responsible Play",
    links: [
      { href: "/guide/how-to-play/#play-safe", label: "Play Safe by Design" },
      { href: "/guide/how-to-play/#step-2", label: "Account Security" },
      { href: "/guide/how-to-play/#step-3", label: "Wallet Management" },
      { href: "/#how-it-works", label: "How It Works" },
    ],
  },
] as const;
---

<footer class="relative mt-8 border-t border-white/5 bg-ink-900/70">
  <div class="container-site py-14 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-mist-400">
          Yarrwin is an online gaming and lottery results platform built for speed and
          transparency — lightning-fast draws, verifiable mechanics and a permanent public
          results archive.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="chip chip-neutral"><Icon name="lock" class="h-3.5 w-3.5" /> 256-bit SSL</span>
          <span class="chip chip-neutral"><Icon name="eye" class="h-3.5 w-3.5" /> Provably fair</span>
          <span class="chip chip-red">18+ only</span>
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-4" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-mist-500">{col.title}</h3>
              <ul class="mt-4 flex flex-col gap-2.5">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-mist-300 transition hover:text-brand-300">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 space-y-4 border-t border-white/5 pt-6 text-xs leading-relaxed text-mist-500">
      <p>
        <strong class="text-mist-400">Responsible gaming:</strong> Yarrwin is intended for
        entertainment only. Set a budget before you play, never chase losses, and take
        regular breaks. Participation is strictly for persons aged 18 or over and is not
        available in jurisdictions where online gaming is prohibited. Check your local
        laws before registering.
      </p>
      <p>
        <strong class="text-mist-400">Demo notice:</strong> results displayed on this
        build are generated by a built-in deterministic simulator for demonstration
        purposes. Wire the components to your live results feed before going to
        production — see <span class="num text-mist-400">src/lib/simulator.ts</span>.
      </p>
      <p>© {year} Yarrwin. All rights reserved. Yarrwin is an independent brand and is not affiliated with any other gaming platform.</p>
    </div>
  </div>
</footer>
