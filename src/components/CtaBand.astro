---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  sub: string;
}

const { title, sub } = Astro.props;
---

<section class="container-site pb-20 md:pb-28">
  <div class="glass-deep relative overflow-hidden rounded-3xl px-6 py-12 text-center shadow-card md:px-12 md:py-16">
    <div
      class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[560px] -translate-x-1/2 rounded-full bg-brand-500/15 blur-[90px]"
      aria-hidden="true"
    >
    </div>
    <h2 class="relative font-display text-3xl font-extrabold tracking-tight md:text-4xl">
      {title}
    </h2>
    <p class="relative mx-auto mt-4 max-w-2xl leading-relaxed text-mist-300">{sub}</p>
    <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/games/" class="btn btn-primary">
        Play Now
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a href="/results/" class="btn btn-ghost">View Results</a>
    </div>
    <p class="relative mt-6 text-xs text-mist-500">
      18+ only · Play responsibly · Not available where prohibited
    </p>
  </div>
</section>
