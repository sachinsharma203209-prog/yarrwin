---
/**
 * FAQSection — self-contained, SEO-friendly FAQ block for Yarrwin.
 *
 * Ships three things in one drop-in component:
 *  1. Crawlable, visible Q&A markup (semantic h2 heading + native
 *     <details>/<summary> accordion — zero client-side JavaScript).
 *  2. A Google-compliant JSON-LD `FAQPage` script embedded directly in the
 *     component, with every `acceptedAnswer.text` wrapped in <p> tags
 *     exactly as required for rich-result eligibility.
 *  3. Keyword-optimised default content covering the Yarrwin brand cluster:
 *     yarrwin app, yarrwin login, yarrwin game, yarrwin lottery,
 *     yarrwin gift code, yarrwin club and yarrwin hack (safety rebuttal).
 *
 * Reuse on any page via `<FAQSection />`, or pass page-specific Q&As with
 * `faqs={...}`. Set `withSchema={false}` when the page already declares a
 * FAQPage elsewhere — Google allows only one FAQPage node per URL.
 */
import SectionHeading from "./SectionHeading.astro";
import FaqAccordion from "./FaqAccordion.astro";

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  /** Q&A pairs. Defaults to the canonical 8 Yarrwin brand FAQs. */
  faqs?: FaqItem[];
  eyebrow?: string;
  title?: string;
  sub?: string;
  /** Section + heading anchor id (default "faq"). */
  id?: string;
  /** Emit the FAQPage JSON-LD script (default true). */
  withSchema?: boolean;
}

/* ---------------------------------------------------------------------------
 * Default FAQ content — 8 questions tuned to high-intent Yarrwin searches.
 * The same strings are rendered visibly (crawlable text) and mirrored into
 * the FAQPage schema below, keeping visible content and structured data
 * identical as Google requires.
 * ------------------------------------------------------------------------- */
const defaultFaqs: FaqItem[] = [
  {
    q: "What is Yarrwin and how do I use the Yarrwin app?",
    a: "Yarrwin is an online gaming and lottery results platform where every draw is published the second it happens. The Yarrwin app is browser-based, so there is nothing to download or install: open yarrwin.com in any modern browser, complete your Yarrwin login, and optionally add the site to your home screen for a full app-style experience. From there you can play WinGo colour prediction, the K3 and 5D lotteries and Aviator, and browse the permanent public results archive.",
  },
  {
    q: "How do I complete my Yarrwin login?",
    a: "Open the official domain, yarrwin.com, choose Login, enter your registered email or mobile number and password, then approve your two-factor prompt if enabled. New players can register in under a minute, and the same Yarrwin game login flow works on desktop and mobile browsers. Always check the address bar before signing in — phishing copies of the login page are the number-one account risk.",
  },
  {
    q: "How do I play the Yarrwin game and lottery draws?",
    a: "Pick a game from the lobby — WinGo colour prediction, the K3 dice lottery, 5D or Aviator — choose your market (a colour, a number, Big or Small, a dice sum or a digit) and confirm your prediction before the countdown ends. Each draw settles in seconds, the outcome is logged to the public archive, and every payout table is published up front on the games page.",
  },
  {
    q: "How often are Yarrwin lottery results drawn and updated?",
    a: "A new WinGo period opens and closes every 60 seconds, K3 draws run every three minutes and 5D every five minutes, around the clock. The live board on the homepage counts down to each next draw in real time, and the results archive updates the moment a period closes — with the winning number, colour, size and UTC timestamp.",
  },
  {
    q: "Where can I find a legitimate Yarrwin gift code, and how do I redeem it?",
    a: "Official Yarrwin gift codes are released only through the platform's own channels — homepage event banners, the announcements board inside your account and Yarrwin Club campaigns. To redeem one, complete your Yarrwin login, open the Wallet screen, choose Gift code, paste the code exactly as issued and confirm. Any third-party 'gift code generator' is a scam and should be avoided and reported.",
  },
  {
    q: "What is the Yarrwin Club and how do I join?",
    a: "The Yarrwin Club is the platform's loyalty programme, and joining is automatic: membership accrues through regular play at no extra cost. Tiers unlock progressively stronger perks, including exclusive gift codes, faster withdrawals, cashback on net losses and priority support. Current thresholds and seasonal terms are published openly on the announcements board.",
  },
  {
    q: "Is Yarrwin safe? Is there a working Yarrwin hack?",
    a: "Yes, the platform is safe — and no, there is no working Yarrwin hack. Outcomes are generated by random number generation under a commit-reveal scheme: the outcome hash is published before each draw and can be re-verified afterwards, so no app, mod or predictor can influence a result. Files marketed as Yarrwin hacks are credential stealers and should never be installed. Accounts are protected by 256-bit encrypted sessions, hashed credentials and optional two-factor authentication — never share your password or an OTP with anyone.",
  },
  {
    q: "Is Yarrwin available in my region?",
    a: "Yarrwin is intended only for adults aged 18 and over and only in jurisdictions where online gaming is legal, so check your local regulations before registering. If gaming ever stops being entertainment, use the built-in session limits and self-exclusion tools described in the Play Safe guide.",
  },
];

const {
  faqs = defaultFaqs,
  eyebrow = "FAQ",
  title = "Yarrwin FAQ — questions, answered plainly",
  sub = "Everything players ask before their first draw — from the Yarrwin app and login to gift codes, the Yarrwin Club and draw verification.",
  id = "faq",
  withSchema = true,
} = Astro.props;

/* ---------------------------------------------------------------------------
 * FAQPage JSON-LD — built from the exact strings rendered above.
 * Every acceptedAnswer.text is wrapped in <p> tags per the required format.
 * `<` is escaped to \u003c so the payload stays XSS-safe inside set:html;
 * JSON parsers (including Google's) read it back as "<p>…</p>".
 * ------------------------------------------------------------------------- */
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: `<p>${f.a}</p>` },
  })),
};

const faqJsonLd = JSON.stringify(faqSchema).replace(/</g, "\\u003c");
---

<section id={id} class="section-pad" aria-labelledby={`${id}-heading`}>
  <div class="container-site grid gap-10 lg:grid-cols-[0.9fr_1.4fr]">
    <SectionHeading eyebrow={eyebrow} title={title} sub={sub} id={`${id}-heading`} />
    <FaqAccordion items={faqs} />
  </div>
  {withSchema && <script is:inline type="application/ld+json" set:html={faqJsonLd} />}
</section>
