---
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
  align?: "left" | "center";
  id?: string;
}

const { eyebrow, title, sub, align = "left", id } = Astro.props;
---

<div class={`max-w-2xl ${align === "center" ? "mx-auto text-center" : ""}`}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-4 font-display text-3xl font-extrabold tracking-tight md:text-4xl">
    {title}
  </h2>
  {sub && <p class="mt-4 leading-relaxed text-mist-400">{sub}</p>}
</div>
