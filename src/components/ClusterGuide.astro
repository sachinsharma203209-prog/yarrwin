---
import ExpandedGuide from "./ExpandedGuide.astro";
interface Props { kind: string; }
const { kind } = Astro.props;
const groups: Record<string,{path:string;label:string;heading:string;title:string;description:string;keyword:string;topic:string}> = {
  transactions:{path:"/transactions/",label:"Transactions hub",heading:"Yarrwin Transaction Guide: Deposits, Withdrawals and Payment Safety",title:"Yarrwin Transactions Guide | Deposits and Safety",description:"Understand Yarrwin deposits, withdrawals, transaction statuses, records, support and payment safety without unverified claims.",keyword:"Yarrwin transactions",topic:"transaction terms and payment safety"},
  deposit:{path:"/transactions/deposit/",label:"Deposit guide",heading:"Yarrwin Deposit Guide: Checks Before You Pay",title:"Yarrwin Deposit Guide | Payment Checks and Safety",description:"Learn safe checks for a Yarrwin deposit, payment confirmation, pending funds, failed payments and fake instructions.",keyword:"Yarrwin deposit guide",topic:"deposit checks and payment confirmation"},
  "withdrawal-pending":{path:"/transactions/withdrawal-pending/",label:"Withdrawal pending",heading:"Yarrwin Withdrawal Pending: Causes and Safety Checks",title:"Yarrwin Withdrawal Pending | Causes and Checks",description:"Understand a pending Yarrwin withdrawal, account checks, duplicate requests, records and safe support steps.",keyword:"Yarrwin withdrawal pending",topic:"pending withdrawal status"},
  "withdrawal-rejected":{path:"/transactions/withdrawal-rejected/",label:"Withdrawal rejected",heading:"Yarrwin Withdrawal Rejected: Reasons and Next Steps",title:"Yarrwin Withdrawal Rejected | Safe Next Steps",description:"Learn the difference between pending, failed and rejected withdrawals and how to preserve evidence safely.",keyword:"Yarrwin withdrawal rejected",topic:"rejected withdrawal status"},
  "payment-failed":{path:"/transactions/payment-failed/",label:"Payment failed",heading:"Yarrwin Payment Failed: Checks Before Retrying",title:"Yarrwin Payment Failed | Troubleshooting Guide",description:"Troubleshoot a failed Yarrwin payment, timeouts, incorrect details, duplicate-payment risk and support evidence.",keyword:"Yarrwin payment failed",topic:"failed payment troubleshooting"},
  "money-debited":{path:"/transactions/money-debited/",label:"Money debited",heading:"Yarrwin Money Debited but Not Credited",title:"Yarrwin Money Debited but Not Credited | Guide",description:"What to do when money is debited but a Yarrwin balance is not credited, including references and scam warnings.",keyword:"Yarrwin money debited but not credited",topic:"debit and platform-credit mismatch"},
  history:{path:"/transactions/history/",label:"Transaction history",heading:"Yarrwin Transaction History: Records and Statuses",title:"Yarrwin Transaction History | Records Guide",description:"Learn how to read Yarrwin transaction history, statuses, references, dates, promotional records and privacy checks.",keyword:"Yarrwin transaction history",topic:"transaction history records"},
  "payment-safety":{path:"/transactions/payment-safety/",label:"Payment safety",heading:"Yarrwin Payment Safety: Protect Accounts and Payments",title:"Yarrwin Payment Safety | Account Protection Guide",description:"Protect Yarrwin payments with domain, device, OTP, QR-code, screen-sharing and fake-support checks.",keyword:"Yarrwin payment safety",topic:"payment security"},
  "bonus-terms":{path:"/transactions/bonus-terms/",label:"Bonus terms",heading:"Yarrwin Bonus Terms: Promotional Balance Explained",title:"Yarrwin Bonus Terms | Promotional Balance Guide",description:"Understand promotional balances, eligibility, expiry and withdrawal restrictions without invented bonus values.",keyword:"Yarrwin bonus terms",topic:"promotional balance terms"},
  troubleshooting:{path:"/troubleshooting/",label:"Troubleshooting hub",heading:"Yarrwin Troubleshooting: Login, App and Payment Problems",title:"Yarrwin Troubleshooting | Login, App and Payment",description:"Find practical Yarrwin troubleshooting routes for login, OTP, apps, results, gift codes and transaction problems.",keyword:"Yarrwin troubleshooting",topic:"account and platform troubleshooting"},
  "login-not-working":{path:"/troubleshooting/login-not-working/",label:"Login problem",heading:"Yarrwin Login Not Working: Checks and Fixes",title:"Yarrwin Login Not Working | Troubleshooting",description:"Troubleshoot Yarrwin login errors, wrong domains, cache, network, OTP requirements and account restrictions safely.",keyword:"Yarrwin login not working",topic:"login error diagnosis"},
  "otp-not-received":{path:"/troubleshooting/otp-not-received/",label:"OTP problem",heading:"Yarrwin OTP Not Received: Safe Retry Steps",title:"Yarrwin OTP Not Received | Safe Troubleshooting",description:"Check phone details, network delay, SMS filtering, expired codes and safe OTP retry steps for Yarrwin.",keyword:"Yarrwin OTP not received",topic:"one-time-code delivery"},
  "forgot-password":{path:"/troubleshooting/forgot-password/",label:"Password recovery",heading:"Yarrwin Forgot Password: Recovery Checks",title:"Yarrwin Forgot Password | Recovery Guide",description:"Recover a Yarrwin password safely with domain checks, reset links, contact details and scam awareness.",keyword:"Yarrwin forgot password",topic:"password recovery"},
  "account-locked":{path:"/troubleshooting/account-locked/",label:"Locked account",heading:"Yarrwin Account Locked: What to Check",title:"Yarrwin Account Locked | Safety and Support",description:"Understand possible account-lock causes, security reviews, evidence and safe support without unlock promises.",keyword:"Yarrwin account locked",topic:"account access restriction"},
  "app-not-installing":{path:"/troubleshooting/app-not-installing/",label:"App installation problem",heading:"Yarrwin App Not Installing: Device and File Checks",title:"Yarrwin App Not Installing | Troubleshooting",description:"Troubleshoot Yarrwin app installation, storage, corrupted files, Android warnings, permissions and fake APK risks.",keyword:"Yarrwin app not installing",topic:"application installation"},
  "app-not-opening":{path:"/troubleshooting/app-not-opening/",label:"App startup problem",heading:"Yarrwin App Not Opening: Safe Troubleshooting",title:"Yarrwin App Not Opening | Startup Guide",description:"Check crashes, updates, storage, cache, network, reinstallation and account safety when an app will not open.",keyword:"Yarrwin app not opening",topic:"application startup"},
  "site-not-loading":{path:"/troubleshooting/site-not-loading/",label:"Website problem",heading:"Yarrwin Website Not Loading: Domain and Browser Checks",title:"Yarrwin Website Not Loading | Troubleshooting",description:"Troubleshoot connection, DNS, cache, SSL, expired bookmarks and mirror-domain risks without following fake links.",keyword:"Yarrwin website not loading",topic:"website loading problem"},
  "gift-code-not-working":{path:"/troubleshooting/gift-code-not-working/",label:"Gift-code problem",heading:"Yarrwin Gift Code Not Working: Checks and Warnings",title:"Yarrwin Gift Code Not Working | Troubleshooting",description:"Check typing, expiry, eligibility, regional limits and fake gift-code generators safely.",keyword:"Yarrwin gift code not working",topic:"invalid gift code"},
  "result-not-showing":{path:"/troubleshooting/result-not-showing/",label:"Result problem",heading:"Yarrwin Result Not Showing: Display and Data Checks",title:"Yarrwin Result Not Showing | Troubleshooting",description:"Troubleshoot missing result displays, period numbers, time zones, cache, data limits and fake screenshots.",keyword:"Yarrwin result not showing",topic:"missing game result"},
  "withdrawal-problem":{path:"/troubleshooting/withdrawal-problem/",label:"Withdrawal router",heading:"Yarrwin Withdrawal Problem: Choose the Right Guide",title:"Yarrwin Withdrawal Problem | Diagnostic Router",description:"Choose the right Yarrwin guide for a general withdrawal, pending request, rejection, payment failure or debit issue.",keyword:"Yarrwin withdrawal problem",topic:"withdrawal diagnosis"},
  "fake-support":{path:"/troubleshooting/fake-support/",label:"Fake support warning",heading:"Fake Yarrwin Customer Support: Impersonation Warning",title:"Fake Yarrwin Customer Support | Safety Guide",description:"Identify fake Yarrwin Telegram, WhatsApp and support profiles, OTP theft, remote access and refund scams.",keyword:"fake Yarrwin customer support",topic:"support impersonation"},
};
const item = groups[kind] ?? groups.troubleshooting;
const banks: Record<string,string[]> = {
  transactions:["Map the full payment journey before opening another screen.","A transaction label is a snapshot of state, not a delivery promise.","Compare the amount, reference and date shown in your own record.","Separate a platform balance from the bank or wallet statement.","Keep one request open while you investigate its response.","Use the history row to locate the event, not to infer a missing result.","A reversal, rejection and pending state require different questions.","Redact financial identifiers before asking anyone for a second opinion.","Choose the narrowest support route that matches the visible status.","Close duplicate tabs and record the confirmed outcome once."] ,
  troubleshooting:["Reproduce the error once and capture its exact wording.","Start with the device, browser and network combination that failed.","Change one variable at a time so the cause remains observable.","A cached screen can look current even when the request is old.","Check whether the issue affects one account or the whole page.","Keep failed and successful attempts in a short timestamped sequence.","Stop when a retry could submit a second request or expose data.","Use recovery screens only from a domain you typed or bookmarked yourself.","Escalate a reproducible symptom rather than a rumour about the platform.","After recovery, remove test files and review active sessions."] ,
  safety:["Treat an unexpected message as an identity question before a support question.","Inspect the address, certificate and spelling before entering credentials.","A QR code or screen-share request can redirect control away from you.","Never use a paid helper as proof that an account action is legitimate.","Keep OTPs, PINs and recovery phrases outside every chat transcript.","If a claim depends on urgency, pause and verify through your own account.","A genuine-looking logo does not verify the person who sent the message.","Save the profile link and time if you need to report impersonation.","Block pressure tactics before they become a payment or installation request.","Review permissions and sessions after any suspicious interaction."]
};
const family = kind.includes("payment") || kind.includes("withdrawal") || kind === "deposit" || kind === "history" || kind === "bonus-terms" || kind === "transactions" ? "transactions" : kind === "fake-support" || kind === "payment-safety" ? "safety" : "troubleshooting";
const scenarios = banks[family].map((s,i) => `${s} For ${item.topic}, use the visible status and identifier at checkpoint ${i+1}; do not fill gaps with a forwarded screenshot or an unverified promise.`);
const sectionTitles = family === "transactions" ? ["Trace the payment path","Read status language","Match references","Check the account record","Avoid duplicate requests","Compare external evidence","Handle waiting periods","Redact before sharing","Select a support route","Record the resolution"] : family === "safety" ? ["Question the sender","Inspect the address","Protect the sign-in","Treat codes as private","Reject remote control","Verify claims yourself","Report pressure tactics","Review account access","Choose safe evidence","Reset your boundaries"] : ["Capture the symptom","Reproduce carefully","Check the environment","Test one change","Read the returned state","Compare a clean attempt","Know when to stop","Protect recovery details","Escalate precisely","Confirm the fix"];
const faqs = family === "transactions" ? [
  {q:"What does this status confirm?",a:`It confirms only the state shown for ${item.topic}; check the account record for the current position.`},
  {q:"Should I submit another request?",a:"Not until the first reference is clearly failed or cancelled; duplicates can make review harder."},
  {q:"What evidence is useful?",a:"Keep the reference, amount, timestamp, status and redacted statement together."},
  {q:"Can a screenshot prove payment?",a:"A screenshot is context, not proof; compare it with your own account and authorised record."},
  {q:"Who can confirm an account status?",a:"Use the support route opened from the platform account, never a stranger’s direct message."}
] : family === "safety" ? [
  {q:"How can I check a support identity?",a:"Open the known domain yourself and compare contact details; a profile image is not authentication."},
  {q:"May I share an OTP to speed things up?",a:"No. One-time codes and passwords must remain private."},
  {q:"What if someone asks for remote access?",a:"Decline, close the conversation and review device permissions."},
  {q:"Should I pay a recovery helper?",a:"Do not pay an unverified intermediary or trust guaranteed-recovery language."},
  {q:"What should I report?",a:"Save the profile, link, message and time without exposing your own credentials."}
] : [
  {q:"What should I capture first?",a:"Save the exact error, page address, time and device context before changing settings."},
  {q:"How many retries are sensible?",a:"Make one controlled retry after a reversible check; repeated taps can create a second problem."},
  {q:"Can clearing data fix every error?",a:"No. It is one diagnostic step and may remove local state, so preserve recovery details first."},
  {q:"When should I escalate?",a:"Escalate a repeatable symptom with a concise timeline and redacted evidence."},
  {q:"Is this page official support?",a:"No. Verify account instructions inside the platform and use its authorised route."}
];
---
<ExpandedGuide {...item} scenarios={scenarios} faqs={faqs} sectionTitles={sectionTitles} sectionSubheads={Array.from({length: 5 + (kind.length % 5)}, (_,i) => `${item.label}: checkpoint ${i+1}`)} />
