---
/**
 * Renders one or more JSON-LD `<script type="application/ld+json">` blocks.
 * `<` is escaped to \u003c to keep the output XSS-safe inside set:html.
 */
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];

const serialize = (obj: Record<string, unknown>): string =>
  JSON.stringify(obj).replace(/</g, "\\u003c");
---

{items.map((item) => <script is:inline type="application/ld+json" set:html={serialize(item)} />)}
