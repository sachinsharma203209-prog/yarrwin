---
export const prerender = false;

import { getEnv } from "../../../../lib/runtime";
import { verifySessionToken, parseCookies } from "../../../../lib/auth";
import { getCategoryById, countPostsByCategory } from "../../../../lib/db";
import AdminLayout from "../../../../components/AdminLayout.astro";

const env = getEnv(Astro);
const cookies = parseCookies(Astro.request.headers.get("cookie"));
const authed = await verifySessionToken(env.DB, cookies["yarrwin_session"]);
if (!authed) return Astro.redirect("/admin/login", 302);

const db = env.DB;
const catId = Number(Astro.params.id);
const category = await getCategoryById(db, catId);
if (!category) return Astro.redirect("/admin/categories", 302);

const postCount = await countPostsByCategory(db, catId);
const siteUrl = Astro.url.origin;
const publicUrl = `${siteUrl}/blog/category/${category.slug}/`;
---

<AdminLayout title={`Edit: ${category.name}`} active="categories">
  <div class="editor-page">
    <div class="editor-main">
      <input type="text" id="name" class="title-input" value={category.name} placeholder="Category name..." autocomplete="off" />

      <div class="slug-row">
        <span class="slug-prefix">Slug:</span>
        <input type="text" id="slug" class="slug-input" value={category.slug} />
      </div>

      <div class="public-url-row">
        <span class="slug-prefix">Public URL:</span>
        <a href={publicUrl} target="_blank" rel="noopener noreferrer" class="public-link">{publicUrl}</a>
      </div>

      <div class="field">
        <label>Description</label>
        <textarea id="description" rows="3" placeholder="Optional category description">{category.description || ""}</textarea>
      </div>

      <div class="seo-panel">
        <button type="button" class="seo-toggle" id="seoToggle">
          <span>SEO Settings</span>
          <span class="seo-arrow">▸</span>
        </button>
        <div class="seo-body hidden" id="seoBody">
          <div class="field"><label>SEO Title</label><input id="seoTitle" value={category.seo_title || ""} placeholder="Custom title for search engines" /></div>
          <div class="field"><label>Meta Description</label><textarea id="metaDesc" rows="2" placeholder="Description for search engine results">{category.meta_description || ""}</textarea></div>
        </div>
      </div>
    </div>

    <div class="editor-sidebar">
      <div class="sidebar-card">
        <h4 class="sidebar-card-title">Category</h4>
        <div class="field">
          <label>Status</label>
          <select id="status">
            <option value="active" selected={category.status === "active"}>Active</option>
            <option value="inactive" selected={category.status === "inactive"}>Inactive</option>
          </select>
        </div>
        <div class="field-info">
          <span class="info-label">Posts in this category:</span>
          <span class="info-value">{postCount}</span>
        </div>
        <div class="btn-stack">
          <button class="btn btn-primary" id="saveBtn">Save Changes</button>
          <button class="btn btn-danger-outline" id="deleteBtn">Delete Category</button>
          <a href="/admin/categories" class="btn btn-ghost">Cancel</a>
        </div>
        <div class="save-status" id="saveStatus"></div>
        <div class="error-msg hidden" id="errorMsg"></div>
      </div>
    </div>
  </div>

  <!-- Delete confirmation modal -->
  <div class="modal-overlay hidden" id="deleteModal">
    <div class="modal">
      <h3 class="modal-title">Delete Category</h3>
      <p class="modal-text">Are you sure you want to delete <strong>{category.name}</strong>?</p>
      <div class="modal-warning">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>{postCount > 0 ? `${postCount} post${postCount === 1 ? "" : "s"} in this category will be moved to Uncategorised.` : "No posts are using this category."}</span>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="cancelDeleteBtn">Cancel</button>
        <button class="btn btn-danger" id="confirmDeleteBtn">Delete Category</button>
      </div>
    </div>
  </div>

  <style>
    .editor-page{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start}
    @media(max-width:900px){.editor-page{grid-template-columns:1fr}}

    .editor-main{min-width:0}
    .title-input{
      width:100%;padding:14px 0;border:0;background:transparent;
      font-size:28px;font-weight:800;color:var(--white);
      font-family:"Sora",sans-serif;letter-spacing:-.02em;outline:none;
    }
    .title-input::placeholder{color:rgba(255,255,255,0.2)}
    .slug-row,.public-url-row{display:flex;align-items:center;gap:8px;margin-bottom:12px}
    .slug-prefix{font-size:13px;color:var(--text-dim);white-space:nowrap}
    .slug-input{
      flex:1;padding:8px 12px;border-radius:8px;border:1px solid var(--border);
      background:var(--card);color:var(--text);font-size:13px;font-family:inherit;
    }
    .slug-input:focus{outline:none;border-color:var(--accent)}
    .public-link{color:var(--accent);font-size:13px;word-break:break-all}
    .public-link:hover{text-decoration:underline}

    .field{margin-bottom:14px}
    .field label{display:block;margin-bottom:5px;font-size:12px;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em}
    .field input,.field textarea,.sidebar-select{
      width:100%;padding:9px 12px;border-radius:8px;
      border:1px solid var(--border);background:var(--bg);
      color:var(--text);font-size:13px;font-family:inherit;
    }
    .field input:focus,.field textarea:focus,.sidebar-select:focus{outline:none;border-color:var(--accent)}

    .field-info{
      display:flex;justify-content:space-between;align-items:center;
      padding:10px 12px;background:var(--bg);border:1px solid var(--border);border-radius:8px;
      margin-bottom:14px;font-size:13px;
    }
    .info-label{color:var(--text-dim)}
    .info-value{font-weight:700;color:var(--white)}

    .seo-panel{
      background:var(--card);border:1px solid var(--border);border-radius:12px;
      overflow:hidden;margin-bottom:24px;
    }
    .seo-toggle{
      width:100%;padding:14px 18px;background:transparent;border:0;
      color:var(--white);font-size:14px;font-weight:700;font-family:inherit;
      cursor:pointer;display:flex;justify-content:space-between;align-items:center;
    }
    .seo-toggle:hover{background:rgb(255 255 255/.03)}
    .seo-arrow{transition:transform .2s;color:var(--text-dim)}
    .seo-arrow.open{transform:rotate(90deg)}
    .seo-body{padding:0 18px 18px}
    .seo-body.hidden{display:none}

    .editor-sidebar{position:sticky;top:84px}
    .sidebar-card{
      background:var(--card);border:1px solid var(--border);border-radius:12px;
      padding:18px;margin-bottom:16px;
    }
    .sidebar-card-title{margin:0 0 14px;font-size:14px;font-weight:700;color:var(--white)}
    .btn-stack{display:flex;flex-direction:column;gap:8px}
    .btn{
      padding:10px 16px;border-radius:10px;border:0;cursor:pointer;
      font-weight:600;font-size:14px;font-family:inherit;transition:all .15s;text-align:center;
      text-decoration:none;display:inline-flex;align-items:center;justify-content:center;
    }
    .btn-primary{background:var(--accent);color:var(--bg)}
    .btn-primary:hover{background:#2ee8a8}
    .btn-ghost{background:rgb(255 255 255/.05);color:var(--text);border:1px solid var(--border)}
    .btn-ghost:hover{background:rgb(255 255 255/.08)}
    .btn-danger-outline{background:transparent;color:var(--danger);border:1px solid rgb(255 77 94/.25)}
    .btn-danger-outline:hover{background:rgb(255 77 94/.08)}
    .save-status{font-size:12px;color:var(--accent);margin-top:10px;text-align:center}
    .error-msg{font-size:13px;color:var(--danger);margin-top:10px;padding:8px 10px;background:rgb(255 77 94/.08);border-radius:8px}
    .error-msg.hidden{display:none}

    .modal-overlay{
      position:fixed;inset:0;background:rgb(0 0 0/.6);z-index:200;
      display:flex;align-items:center;justify-content:center;
    }
    .modal-overlay.hidden{display:none}
    .modal{
      background:var(--card);border:1px solid var(--border);border-radius:16px;
      padding:28px;max-width:440px;width:90%;
    }
    .modal-title{margin:0 0 12px;font-size:18px;font-weight:700;color:var(--white)}
    .modal-text{margin:0 0 16px;font-size:14px;color:var(--text);line-height:1.5}
    .modal-warning{
      display:flex;align-items:flex-start;gap:10px;
      padding:12px 14px;background:rgb(255 191 0/.08);border:1px solid rgb(255 191 0/.2);
      border-radius:10px;margin-bottom:20px;font-size:13px;color:#fbbf24;line-height:1.4;
    }
    .modal-warning svg{flex-shrink:0;margin-top:2px}
    .modal-actions{display:flex;gap:10px;justify-content:flex-end}
  </style>

  <script type="module" define:vars={{ catId: category.id }}>
    const nameInput = document.getElementById("name");
    const slugInput = document.getElementById("slug");
    const seoToggle = document.getElementById("seoToggle");
    const seoBody = document.getElementById("seoBody");
    const seoArrow = document.querySelector(".seo-arrow");
    const saveBtn = document.getElementById("saveBtn");
    const deleteBtn = document.getElementById("deleteBtn");
    const saveStatus = document.getElementById("saveStatus");
    const errorMsg = document.getElementById("errorMsg");
    const deleteModal = document.getElementById("deleteModal");

    nameInput.addEventListener("input", () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameInput.value
          .toLowerCase().trim()
          .normalize("NFKD").replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9\s-]/g, "")
          .replace(/\s+/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
      }
    });

    slugInput.addEventListener("input", () => { slugInput.dataset.manual = "1"; });

    seoToggle.addEventListener("click", () => {
      seoBody.classList.toggle("hidden");
      seoArrow.classList.toggle("open");
    });

    async function api(path, opts = {}) {
      const res = await fetch(path, {
        headers: { "Content-Type": "application/json" },
        credentials: "include", ...opts,
      });
      if (res.status === 401) { window.location.href = "/admin/login"; throw new Error("unauthorized"); }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(typeof data.error === "string" ? data.error : JSON.stringify(data.error));
      return data;
    }

    saveBtn.addEventListener("click", async () => {
      errorMsg.classList.add("hidden");
      saveStatus.textContent = "Saving...";
      try {
        const payload = {
          name: nameInput.value.trim(),
          slug: slugInput.value.trim(),
          description: document.getElementById("description").value.trim(),
          status: document.getElementById("status").value,
          seo_title: document.getElementById("seoTitle").value.trim(),
          meta_description: document.getElementById("metaDesc").value.trim(),
        };
        if (!payload.name) throw new Error("Name is required");
        await api(`/api/categories/${catId}`, { method: "PUT", body: JSON.stringify(payload) });
        saveStatus.textContent = "Saved";
        hasUnsaved = false;
      } catch (e) {
        saveStatus.textContent = "";
        errorMsg.textContent = e.message;
        errorMsg.classList.remove("hidden");
      }
    });

    deleteBtn.addEventListener("click", () => {
      deleteModal.classList.remove("hidden");
    });

    document.getElementById("cancelDeleteBtn").addEventListener("click", () => {
      deleteModal.classList.add("hidden");
    });

    document.getElementById("confirmDeleteBtn").addEventListener("click", async () => {
      try {
        await api(`/api/categories/${catId}`, { method: "DELETE" });
        window.location.href = "/admin/categories";
      } catch (e) {
        errorMsg.textContent = "Delete failed: " + e.message;
        errorMsg.classList.remove("hidden");
        deleteModal.classList.add("hidden");
      }
    });
  </script>
</AdminLayout>
