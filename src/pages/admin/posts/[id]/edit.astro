---
export const prerender = false;

import { getEnv } from "../../../../lib/runtime";
import { verifySessionToken, parseCookies } from "../../../../lib/auth";
import { getPostById, listCategories } from "../../../../lib/db";
import AdminLayout from "../../../../components/AdminLayout.astro";

const env = getEnv(Astro);
const cookies = parseCookies(Astro.request.headers.get("cookie"));
const authed = await verifySessionToken(env.DB, cookies["yarrwin_session"]);
if (!authed) return Astro.redirect("/admin/login", 302);

const db = env.DB;
const postId = Number(Astro.params.id);
const post = await getPostById(db, postId);
if (!post) return Astro.redirect("/admin/posts", 302);

const { categories } = await listCategories(db, { onlyActive: true, perPage: 100 });

const siteUrl = Astro.url.origin;
const publicUrl = `${siteUrl}/blog/${post.slug}/`;
---

<AdminLayout title={`Edit: ${post.title}`} active="posts">
  <div class="editor-page">
    <div class="editor-main">
      <input type="text" id="title" class="title-input" value={post.title} placeholder="Post title..." autocomplete="off" />

      <div class="slug-row">
        <span class="slug-prefix">Slug:</span>
        <input type="text" id="slug" class="slug-input" value={post.slug} />
      </div>

      <div class="public-url-row">
        <span class="slug-prefix">Public URL:</span>
        <a href={publicUrl} target="_blank" rel="noopener noreferrer" class="public-link">{publicUrl}</a>
      </div>

      <div class="editor-wrapper">
        <textarea id="content" class="body-input" rows="18" placeholder="Write your complete post body here...">{post.content || ""}</textarea>
      </div>

      <div class="seo-panel">
        <button type="button" class="seo-toggle" id="seoToggle">
          <span>SEO Settings</span>
          <span class="seo-arrow">▸</span>
        </button>
        <div class="seo-body hidden" id="seoBody">
          <div class="field"><label>SEO Title</label><input id="seoTitle" value={post.seo_title || ""} placeholder="Custom title for search engines" /></div>
          <div class="field"><label>Meta Description</label><textarea id="metaDesc" rows="2" placeholder="Description for search engine results">{post.meta_description || ""}</textarea></div>
          <div class="field"><label>Canonical URL</label><input id="canonicalUrl" value={post.canonical_url || ""} placeholder="https://yarrwin.online/blog/post-slug" /></div>
          <div class="field-row">
            <label class="checkbox-label"><input type="checkbox" id="robotsIndex" checked={post.robots_index !== 0} /> Index</label>
            <label class="checkbox-label"><input type="checkbox" id="robotsFollow" checked={post.robots_follow !== 0} /> Follow</label>
          </div>
          <div class="field"><label>OG Title</label><input id="ogTitle" value={post.og_title || ""} placeholder="Title for social sharing" /></div>
          <div class="field"><label>OG Description</label><textarea id="ogDesc" rows="2" placeholder="Description for social sharing">{post.og_description || ""}</textarea></div>
          <div class="field"><label>OG Image URL</label><input id="ogImage" value={post.og_image_url || ""} placeholder="Image URL for social sharing" /></div>
        </div>
      </div>
    </div>

    <div class="editor-sidebar">
      <div class="sidebar-card">
        <h4 class="sidebar-card-title">Publish</h4>
        <div class="field">
          <label>Status</label>
          <select id="status">
            <option value="draft" selected={post.status === "draft"}>Draft</option>
            <option value="published" selected={post.status === "published"}>Published</option>
          </select>
        </div>
        <div class="btn-stack">
          <button class="btn btn-ghost" id="saveDraftBtn">Save Draft</button>
          <button class="btn btn-primary" id="publishBtn">{post.status === "published" ? "Update" : "Publish"}</button>
          <button class="btn btn-danger-outline" id="deleteBtn">Delete Post</button>
        </div>
        <div class="save-status" id="saveStatus"></div>
        <div class="error-msg hidden" id="errorMsg"></div>
      </div>

      <div class="sidebar-card">
        <h4 class="sidebar-card-title">Category</h4>
        <select id="category" class="sidebar-select">
          <option value="">— None —</option>
          {categories.map((c) => (
            <option value={c.id} selected={c.id === post.category_id}>{c.name}</option>
          ))}
        </select>
      </div>

      <div class="sidebar-card">
        <h4 class="sidebar-card-title">Featured Image</h4>
        <div class="featured-image-area">
          <img id="imagePreview" class:list={["image-preview", !post.featured_image && "hidden"]} src={post.featured_image || ""} alt="" />
          <button type="button" class="btn btn-ghost btn-sm" id="uploadBtn">Upload via ImageKit</button>
          <input type="text" id="featuredImage" class="image-url-input" value={post.featured_image || ""} placeholder="Or paste image URL" />
        </div>
      </div>
    </div>
  </div>

  <style>
    .editor-page{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start}
    @media(max-width:900px){.editor-page{grid-template-columns:1fr}}

    .editor-main{min-width:0}
    .title-input{
      width:100%;padding:14px 0;border:0;background:transparent;
      font-size:28px;font-weight:800;color:var(--white);
      font-family:"Sora",sans-serif;letter-spacing:-.02em;outline:none;
    }
    .title-input::placeholder{color:rgba(255,255,255,0.2)}
    .slug-row,.public-url-row{display:flex;align-items:center;gap:8px;margin-bottom:12px}
    .slug-prefix{font-size:13px;color:var(--text-dim);white-space:nowrap}
    .slug-input{
      flex:1;padding:8px 12px;border-radius:8px;border:1px solid var(--border);
      background:var(--card);color:var(--text);font-size:13px;font-family:inherit;
    }
    .slug-input:focus{outline:none;border-color:var(--accent)}
    .public-link{color:var(--accent);font-size:13px;word-break:break-all}
    .public-link:hover{text-decoration:underline}
    .editor-wrapper{margin-bottom:24px}
    .body-input{width:100%;min-height:460px;resize:vertical;padding:22px 24px;border-radius:14px;border:1px solid var(--border);background:var(--card);color:var(--text);font:15px/1.75 inherit;outline:none}
    .body-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgb(0 214 143/.1)}
    .body-input::placeholder{color:var(--text-dim)}

    .seo-panel{
      background:var(--card);border:1px solid var(--border);border-radius:12px;
      overflow:hidden;margin-bottom:24px;
    }
    .seo-toggle{
      width:100%;padding:14px 18px;background:transparent;border:0;
      color:var(--white);font-size:14px;font-weight:700;font-family:inherit;
      cursor:pointer;display:flex;justify-content:space-between;align-items:center;
    }
    .seo-toggle:hover{background:rgb(255 255 255/.03)}
    .seo-arrow{transition:transform .2s;color:var(--text-dim)}
    .seo-arrow.open{transform:rotate(90deg)}
    .seo-body{padding:0 18px 18px}
    .seo-body.hidden{display:none}
    .field-row{display:flex;gap:16px;margin-bottom:14px}
    .checkbox-label{
      display:flex;align-items:center;gap:6px;font-size:13px;
      color:var(--text);cursor:pointer;
    }
    .checkbox-label input{accent-color:var(--accent)}

    .field{margin-bottom:14px}
    .field label{display:block;margin-bottom:5px;font-size:12px;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em}
    .field input,.field textarea,.sidebar-select{
      width:100%;padding:9px 12px;border-radius:8px;
      border:1px solid var(--border);background:var(--bg);
      color:var(--text);font-size:13px;font-family:inherit;
    }
    .field input:focus,.field textarea:focus,.sidebar-select:focus{outline:none;border-color:var(--accent)}

    .editor-sidebar{position:sticky;top:84px}
    .sidebar-card{
      background:var(--card);border:1px solid var(--border);border-radius:12px;
      padding:18px;margin-bottom:16px;
    }
    .sidebar-card-title{margin:0 0 14px;font-size:14px;font-weight:700;color:var(--white)}
    .sidebar-select{
      width:100%;padding:9px 12px;border-radius:8px;
      border:1px solid var(--border);background:var(--bg);
      color:var(--text);font-size:13px;font-family:inherit;
    }
    .btn-stack{display:flex;flex-direction:column;gap:8px}
    .btn{
      padding:10px 16px;border-radius:10px;border:0;cursor:pointer;
      font-weight:600;font-size:14px;font-family:inherit;transition:all .15s;text-align:center;
    }
    .btn-primary{background:var(--accent);color:var(--bg)}
    .btn-primary:hover{background:#2ee8a8}
    .btn-ghost{background:rgb(255 255 255/.05);color:var(--text);border:1px solid var(--border)}
    .btn-ghost:hover{background:rgb(255 255 255/.08)}
    .btn-danger-outline{background:transparent;color:var(--danger);border:1px solid rgb(255 77 94/.25)}
    .btn-danger-outline:hover{background:rgb(255 77 94/.08)}
    .btn-sm{padding:7px 12px;font-size:13px}
    .save-status{font-size:12px;color:var(--accent);margin-top:10px;text-align:center}
    .error-msg{font-size:13px;color:var(--danger);margin-top:10px;padding:8px 10px;background:rgb(255 77 94/.08);border-radius:8px}
    .error-msg.hidden{display:none}

    .featured-image-area{display:flex;flex-direction:column;gap:8px}
    .image-preview{width:100%;border-radius:8px;object-fit:cover;max-height:160px}
    .image-preview.hidden{display:none}
    .image-url-input{
      width:100%;padding:8px 12px;border-radius:8px;
      border:1px solid var(--border);background:var(--bg);
      color:var(--text);font-size:13px;font-family:inherit;
    }
  </style>

  <script type="module" define:vars={{ postId: post.id }}>
    const titleInput = document.getElementById("title");
    const slugInput = document.getElementById("slug");
    const statusSelect = document.getElementById("status");
    const categorySelect = document.getElementById("category");
    const featuredImageInput = document.getElementById("featuredImage");
    const imagePreview = document.getElementById("imagePreview");
    const seoToggle = document.getElementById("seoToggle");
    const seoBody = document.getElementById("seoBody");
    const seoArrow = document.querySelector(".seo-arrow");
    const saveDraftBtn = document.getElementById("saveDraftBtn");
    const publishBtn = document.getElementById("publishBtn");
    const deleteBtn = document.getElementById("deleteBtn");
    const saveStatus = document.getElementById("saveStatus");
    const errorMsg = document.getElementById("errorMsg");

    const contentField = document.getElementById("content");
    contentField.addEventListener("input", () => { hasUnsaved = true; });
    let hasUnsaved = false;

    titleInput.addEventListener("input", () => { markUnsaved(); });
    slugInput.addEventListener("input", () => { markUnsaved(); });
    statusSelect.addEventListener("change", markUnsaved);
    categorySelect.addEventListener("change", markUnsaved);
    featuredImageInput.addEventListener("input", () => {
      const url = featuredImageInput.value.trim();
      if (url) { imagePreview.src = url; imagePreview.classList.remove("hidden"); }
      else { imagePreview.classList.add("hidden"); }
      markUnsaved();
    });

    seoToggle.addEventListener("click", () => {
      seoBody.classList.toggle("hidden");
      seoArrow.classList.toggle("open");
    });

    document.getElementById("uploadBtn").addEventListener("click", () => {
      const input = document.createElement("input");
      input.type = "file"; input.accept = "image/*";
      input.onchange = async () => {
        const file = input.files[0]; if (!file) return;
        saveStatus.textContent = "Uploading...";
        try {
          const fd = new FormData();
          fd.append("file", file);
          const up = await fetch("/api/media", { method: "POST", body: fd, credentials: "include" });
          const data = await up.json();
          if (!up.ok) throw new Error(data.error || "Upload failed");
          featuredImageInput.value = data.media.original_url;
          imagePreview.src = data.media.original_url; imagePreview.classList.remove("hidden");
          saveStatus.textContent = "";
        } catch (e) { saveStatus.textContent = "Upload error: " + e.message; }
      };
      input.click();
    });

    function markUnsaved() { hasUnsaved = true; }

    window.addEventListener("beforeunload", (e) => {
      if (hasUnsaved) { e.preventDefault(); e.returnValue = ""; }
    });

    async function api(path, opts = {}) {
      const res = await fetch(path, {
        headers: { "Content-Type": "application/json" },
        credentials: "include", ...opts,
      });
      if (res.status === 401) { window.location.href = "/admin/login"; throw new Error("unauthorized"); }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Request failed");
      return data;
    }

    function getPayload(status) {
      return {
        title: titleInput.value.trim(),
        slug: slugInput.value.trim(),
        content: contentField.value.trim(),
        category_id: categorySelect.value ? Number(categorySelect.value) : null,
        status,
        featured_image: featuredImageInput.value.trim(),
        featured_image_alt: "",
        seo_title: document.getElementById("seoTitle").value.trim(),
        meta_description: document.getElementById("metaDesc").value.trim(),
        canonical_url: document.getElementById("canonicalUrl").value.trim(),
        robots_index: document.getElementById("robotsIndex").checked,
        robots_follow: document.getElementById("robotsFollow").checked,
        og_title: document.getElementById("ogTitle").value.trim(),
        og_description: document.getElementById("ogDesc").value.trim(),
        og_image_url: document.getElementById("ogImage").value.trim(),
      };
    }

    async function save(status) {
      errorMsg.classList.add("hidden");
      saveStatus.textContent = "Saving...";
      try {
        const payload = getPayload(status);
        if (!payload.title) throw new Error("Title is required");
        await api(`/api/posts/${postId}`, { method: "PUT", body: JSON.stringify(payload) });
        saveStatus.textContent = "Saved";
        hasUnsaved = false;
      } catch (e) {
        saveStatus.textContent = "";
        errorMsg.textContent = e.message;
        errorMsg.classList.remove("hidden");
      }
    }

    saveDraftBtn.addEventListener("click", () => save("draft"));
    publishBtn.addEventListener("click", () => save("published"));

    deleteBtn.addEventListener("click", async () => {
      if (!confirm("Are you sure you want to delete this post? This action cannot be undone.")) return;
      try {
        await api(`/api/posts/${postId}`, { method: "DELETE" });
        window.location.href = "/admin/posts";
      } catch (e) {
        errorMsg.textContent = "Delete failed: " + e.message;
        errorMsg.classList.remove("hidden");
      }
    });
  </script>
</AdminLayout>
