---
export const prerender = false;

import { getEnv } from "../../../lib/runtime";
import { verifySessionToken, parseCookies } from "../../../lib/auth";
import AdminLayout from "../../../components/AdminLayout.astro";

const env = getEnv(Astro);
const cookies = parseCookies(Astro.request.headers.get("cookie"));
const authed = await verifySessionToken(env.DB, cookies["yarrwin_session"]);
if (!authed) return Astro.redirect("/admin/login", 302);
---

<AdminLayout title="Media Library" active="media">
  <div class="page-header">
    <h2 class="page-title">Media Library</h2>
    <button type="button" class="btn btn-primary" id="uploadTrigger">+ Upload Image</button>
    <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden-input" />
  </div>

  <div class="filters-bar">
    <div class="search-wrap">
      <input type="text" id="searchInput" placeholder="Search by filename or alt text..." class="search-input" />
    </div>
  </div>

  <div id="mediaContainer">
    <div class="loading-state" id="loadingState">Loading media...</div>
  </div>

  <div class="pagination" id="pagination"></div>

  <!-- Edit modal -->
  <div class="modal-overlay hidden" id="editModal">
    <div class="modal">
      <div class="modal-header">
        <h3 class="modal-title">Edit Image</h3>
        <button class="modal-close" id="closeEditModal">&times;</button>
      </div>
      <div class="modal-body">
        <img id="editPreview" class="edit-preview" src="" alt="" />
        <div class="field">
          <label>Alt Text</label>
          <input type="text" id="editAltText" placeholder="Describe this image" />
        </div>
        <div class="field">
          <label>URL</label>
          <div class="url-row">
            <input type="text" id="editUrl" readonly class="url-input" />
            <button class="btn btn-ghost btn-sm" id="copyUrlBtn">Copy</button>
          </div>
        </div>
        <div class="field-info-grid">
          <div class="field-info"><span class="info-label">Filename</span><span class="info-value" id="editFilename">—</span></div>
          <div class="field-info"><span class="info-label">Dimensions</span><span class="info-value" id="editDimensions">—</span></div>
          <div class="field-info"><span class="info-label">Size</span><span class="info-value" id="editSize">—</span></div>
          <div class="field-info"><span class="info-label">Uploaded</span><span class="info-value" id="editDate">—</span></div>
        </div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-danger-outline btn-sm" id="deleteMediaBtn">Delete</button>
        <div class="modal-actions-right">
          <button class="btn btn-ghost btn-sm" id="cancelEditBtn">Cancel</button>
          <button class="btn btn-primary btn-sm" id="saveEditBtn">Save</button>
        </div>
      </div>
      <div class="error-msg hidden" id="editError"></div>
    </div>
  </div>

  <!-- Delete confirmation modal -->
  <div class="modal-overlay hidden" id="deleteModal">
    <div class="modal">
      <h3 class="modal-title">Delete Image</h3>
      <p class="modal-text">Are you sure you want to delete this image?</p>
      <div class="modal-warning hidden" id="deleteWarning">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span>This image is used by one or more posts. Remove it from posts first.</span>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost btn-sm" id="cancelDeleteBtn">Cancel</button>
        <button class="btn btn-danger btn-sm" id="confirmDeleteBtn">Delete</button>
      </div>
    </div>
  </div>

  <style is:global>
    .page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
    .page-title{margin:0;font-size:22px;font-weight:800;color:var(--white);font-family:"Sora",sans-serif}
    .btn{
      padding:10px 20px;border-radius:10px;border:0;cursor:pointer;
      font-weight:600;font-size:14px;font-family:inherit;transition:all .15s;
      text-decoration:none;display:inline-flex;align-items:center;
    }
    .btn-primary{background:var(--accent);color:var(--bg)}
    .btn-primary:hover{background:#2ee8a8}
    .btn:disabled{opacity:.55;cursor:not-allowed}
    .btn-ghost{background:rgb(255 255 255/.05);color:var(--text);border:1px solid var(--border)}
    .btn-ghost:hover{background:rgb(255 255 255/.08)}
    .btn-danger{background:var(--danger);color:#fff}
    .btn-danger:hover{background:#ff6675}
    .btn-danger-outline{background:transparent;color:var(--danger);border:1px solid rgb(255 77 94/.25)}
    .btn-danger-outline:hover{background:rgb(255 77 94/.08)}
    .btn-sm{padding:7px 14px;font-size:13px;border-radius:8px}
    .hidden-input{display:none}

    .filters-bar{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}
    .search-wrap{flex:1;min-width:200px}
    .search-input{
      width:100%;padding:10px 14px;border-radius:10px;
      border:1px solid var(--border);background:var(--card);
      color:var(--text);font-size:14px;font-family:inherit;
    }
    .search-input:focus{outline:none;border-color:var(--accent)}

    .media-grid{
      display:grid;gap:16px;
      grid-template-columns:repeat(4, 1fr);
    }
    @media(max-width:1100px){.media-grid{grid-template-columns:repeat(3, 1fr)}}
    @media(max-width:768px){.media-grid{grid-template-columns:repeat(2, 1fr)}}
    @media(max-width:480px){.media-grid{grid-template-columns:1fr}}

    .media-card{
      background:var(--card);border:1px solid var(--border);border-radius:12px;
      overflow:hidden;cursor:pointer;transition:all .15s;
    }
    .media-card:hover{border-color:var(--accent);transform:translateY(-2px)}
    .media-thumb{
      width:100%;aspect-ratio:4/3;object-fit:cover;background:rgb(255 255 255/.05);
      display:block;
    }
    .media-info{padding:10px 12px}
    .media-filename{
      font-size:12px;font-weight:600;color:var(--white);
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    }
    .media-meta{font-size:11px;color:var(--text-dim);margin-top:4px}
    .media-alt{
      font-size:11px;color:var(--text-dim);margin-top:2px;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
      font-style:italic;
    }

    .upload-status{
      text-align:center;padding:20px;color:var(--accent);font-size:14px;
      background:var(--card);border:1px solid var(--border);border-radius:12px;
      margin-bottom:16px;
    }

    .loading-state,.empty-state{
      text-align:center;padding:48px 20px;color:var(--text-dim);font-size:14px;
      background:var(--card);border:1px solid var(--border);border-radius:12px;
    }

    .pagination{display:flex;justify-content:center;gap:6px;margin-top:20px}
    .page-btn{
      padding:8px 14px;border-radius:8px;border:1px solid var(--border);
      background:var(--card);color:var(--text);font-size:13px;font-weight:500;
      cursor:pointer;transition:all .12s;
    }
    .page-btn:hover{border-color:var(--accent);color:var(--accent)}
    .page-btn.active{background:var(--accent);color:var(--bg);border-color:var(--accent)}
    .page-btn:disabled{opacity:.4;cursor:not-allowed}

    .modal-overlay{
      position:fixed;inset:0;background:rgb(0 0 0/.6);z-index:200;
      display:flex;align-items:center;justify-content:center;
    }
    .modal-overlay.hidden{display:none}
    .modal{
      background:var(--card);border:1px solid var(--border);border-radius:16px;
      padding:28px;max-width:520px;width:90%;
    }
    .modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
    .modal-title{margin:0;font-size:18px;font-weight:700;color:var(--white)}
    .modal-close{
      background:none;border:none;color:var(--text-dim);font-size:24px;cursor:pointer;
      padding:0;line-height:1;
    }
    .modal-close:hover{color:var(--white)}
    .modal-body{margin-bottom:20px}
    .modal-text{margin:0 0 16px;font-size:14px;color:var(--text);line-height:1.5}
    .modal-actions{display:flex;gap:10px;justify-content:space-between;align-items:center}
    .modal-actions-right{display:flex;gap:10px}

    .edit-preview{
      width:100%;max-height:240px;object-fit:contain;border-radius:8px;
      margin-bottom:16px;background:rgb(255 255 255/.05);
    }

    .field{margin-bottom:14px}
    .field label{display:block;margin-bottom:5px;font-size:12px;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em}
    .field input{
      width:100%;padding:9px 12px;border-radius:8px;
      border:1px solid var(--border);background:var(--bg);
      color:var(--text);font-size:13px;font-family:inherit;
    }
    .field input:focus{outline:none;border-color:var(--accent)}

    .url-row{display:flex;gap:8px}
    .url-input{flex:1}

    .field-info-grid{
      display:grid;grid-template-columns:1fr 1fr;gap:10px;
    }
    .field-info{
      padding:8px 10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;
      font-size:12px;
    }
    .info-label{display:block;color:var(--text-dim);margin-bottom:2px}
    .info-value{display:block;color:var(--white);font-weight:600}

    .modal-warning{
      display:flex;align-items:flex-start;gap:10px;
      padding:12px 14px;background:rgb(255 191 0/.08);border:1px solid rgb(255 191 0/.2);
      border-radius:10px;margin-bottom:20px;font-size:13px;color:#fbbf24;line-height:1.4;
    }
    .modal-warning.hidden{display:none}
    .modal-warning svg{flex-shrink:0;margin-top:2px}

    .error-msg{font-size:13px;color:var(--danger);margin-top:10px;padding:8px 10px;background:rgb(255 77 94/.08);border-radius:8px}
    .error-msg.hidden{display:none}
  </style>

  <script type="module">
    const container = document.getElementById("mediaContainer");
    const loadingState = document.getElementById("loadingState");
    const paginationEl = document.getElementById("pagination");
    const searchInput = document.getElementById("searchInput");
    const uploadTrigger = document.getElementById("uploadTrigger");
    const fileInput = document.getElementById("fileInput");
    const editModal = document.getElementById("editModal");
    const deleteModal = document.getElementById("deleteModal");

    let currentPage = 1;
    let debounceTimer = null;
    let editingMedia = null;
    let deletingMediaId = null;

    async function api(path, opts = {}) {
      const res = await fetch(path, {
        headers: { "Content-Type": "application/json" },
        credentials: "include", ...opts,
      });
      if (res.status === 401) { window.location.href = "/admin/login"; throw new Error("unauthorized"); }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Request failed");
      return data;
    }

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
      }[c]));
    }

    function fmtDate(iso) {
      if (!iso) return "—";
      return new Date(iso).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
    }

    function fmtSize(bytes) {
      if (!bytes) return "—";
      if (bytes < 1024) return bytes + " B";
      if (bytes < 1048576) return (bytes / 1024).toFixed(1) + " KB";
      return (bytes / 1048576).toFixed(1) + " MB";
    }

    async function loadMedia() {
      loadingState.style.display = "block";
      container.innerHTML = "";
      container.appendChild(loadingState);

      const params = new URLSearchParams();
      params.set("page", String(currentPage));
      params.set("perPage", "24");
      const search = searchInput.value.trim();
      if (search) params.set("search", search);

      try {
        const data = await api(`/api/media?${params.toString()}`);
        const media = data.media || [];
        const total = data.total || 0;
        const perPage = 24;
        const totalPages = Math.ceil(total / perPage);

        if (media.length === 0) {
          container.innerHTML = '<div class="empty-state">No media found. Upload your first image.</div>';
          paginationEl.innerHTML = "";
          return;
        }

        let html = '<div class="media-grid">';
        for (const m of media) {
          const thumb = m.thumbnail_url || m.original_url;
          const dims = m.width && m.height ? `${m.width}×${m.height}` : "—";
          html += `<div class="media-card" data-id="${m.id}">`;
          html += `<img class="media-thumb" src="${esc(thumb)}" alt="${esc(m.alt_text || m.filename)}" loading="lazy" onerror="this.style.background='rgb(255 255 255/.08)'" />`;
          html += `<div class="media-info">`;
          html += `<div class="media-filename" title="${esc(m.filename)}">${esc(m.filename)}</div>`;
          html += `<div class="media-meta">${esc(dims)} · ${fmtSize(m.size_bytes)}</div>`;
          if (m.alt_text) html += `<div class="media-alt">${esc(m.alt_text)}</div>`;
          html += `</div></div>`;
        }
        html += '</div>';
        container.innerHTML = html;

        renderPagination(totalPages);

        document.querySelectorAll(".media-card").forEach((card) => {
          card.addEventListener("click", () => openEditModal(Number(card.dataset.id), media));
        });
      } catch (e) {
        container.innerHTML = `<div class="empty-state" style="color:var(--danger)">Error loading media: ${esc(e.message)}</div>`;
      }
    }

    function renderPagination(totalPages) {
      if (totalPages <= 1) { paginationEl.innerHTML = ""; return; }
      let html = "";
      html += `<button class="page-btn" data-page="${currentPage - 1}" ${currentPage <= 1 ? "disabled" : ""}>← Prev</button>`;
      for (let i = 1; i <= totalPages; i++) {
        html += `<button class="page-btn ${i === currentPage ? "active" : ""}" data-page="${i}">${i}</button>`;
      }
      html += `<button class="page-btn" data-page="${currentPage + 1}" ${currentPage >= totalPages ? "disabled" : ""}>Next →</button>`;
      paginationEl.innerHTML = html;
      paginationEl.querySelectorAll(".page-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const page = Number(btn.dataset.page);
          if (page >= 1 && page !== currentPage) { currentPage = page; loadMedia(); }
        });
      });
    }

    function openEditModal(mediaId, mediaList) {
      const m = mediaList.find((item) => item.id === mediaId);
      if (!m) return;
      editingMedia = m;

      document.getElementById("editPreview").src = m.thumbnail_url || m.original_url;
      document.getElementById("editAltText").value = m.alt_text || "";
      document.getElementById("editUrl").value = m.original_url;
      document.getElementById("editFilename").textContent = m.filename;
      document.getElementById("editDimensions").textContent = m.width && m.height ? `${m.width}×${m.height}` : "—";
      document.getElementById("editSize").textContent = fmtSize(m.size_bytes);
      document.getElementById("editDate").textContent = fmtDate(m.created_at);
      document.getElementById("editError").classList.add("hidden");
      editModal.classList.remove("hidden");
    }

    document.getElementById("closeEditModal").addEventListener("click", () => {
      editModal.classList.add("hidden");
      editingMedia = null;
    });

    document.getElementById("cancelEditBtn").addEventListener("click", () => {
      editModal.classList.add("hidden");
      editingMedia = null;
    });

    document.getElementById("copyUrlBtn").addEventListener("click", () => {
      const urlInput = document.getElementById("editUrl");
      navigator.clipboard.writeText(urlInput.value).then(() => {
        document.getElementById("copyUrlBtn").textContent = "Copied!";
        setTimeout(() => { document.getElementById("copyUrlBtn").textContent = "Copy"; }, 2000);
      });
    });

    document.getElementById("saveEditBtn").addEventListener("click", async () => {
      if (!editingMedia) return;
      const editError = document.getElementById("editError");
      editError.classList.add("hidden");
      try {
        await api(`/api/media/${editingMedia.id}`, {
          method: "PUT",
          body: JSON.stringify({ alt_text: document.getElementById("editAltText").value.trim() }),
        });
        editModal.classList.add("hidden");
        editingMedia = null;
        loadMedia();
      } catch (e) {
        editError.textContent = e.message;
        editError.classList.remove("hidden");
      }
    });

    document.getElementById("deleteMediaBtn").addEventListener("click", () => {
      if (!editingMedia) return;
      deletingMediaId = editingMedia.id;
      editModal.classList.add("hidden");
      document.getElementById("deleteWarning").classList.add("hidden");
      deleteModal.classList.remove("hidden");
    });

    document.getElementById("cancelDeleteBtn").addEventListener("click", () => {
      deleteModal.classList.add("hidden");
      deletingMediaId = null;
    });

    document.getElementById("confirmDeleteBtn").addEventListener("click", async () => {
      if (!deletingMediaId) return;
      try {
        await api(`/api/media/${deletingMediaId}`, { method: "DELETE" });
        deleteModal.classList.add("hidden");
        deletingMediaId = null;
        loadMedia();
      } catch (e) {
        if (e.message.includes("used by a post")) {
          document.getElementById("deleteWarning").classList.remove("hidden");
        } else {
          alert("Delete failed: " + e.message);
          deleteModal.classList.add("hidden");
        }
      }
    });

    // Upload flow
    uploadTrigger.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", async () => {
      const file = fileInput.files[0];
      if (!file) return;

      if (!file.type.startsWith("image/")) {
        alert("Please choose an image file.");
        fileInput.value = "";
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        alert("Image must be smaller than 10 MB.");
        fileInput.value = "";
        return;
      }

      uploadTrigger.disabled = true;
      uploadTrigger.textContent = "Uploading...";

      const statusEl = document.createElement("div");
      statusEl.className = "upload-status";
      statusEl.textContent = "Uploading...";
      container.prepend(statusEl);

      try {
        const fd = new FormData();
        fd.append("file", file);
        const upRes = await fetch("/api/media", {
          method: "POST",
          body: fd,
          credentials: "include",
        });
        const upData = await upRes.json();
        if (!upRes.ok) throw new Error(upData.error || "Upload failed");

        statusEl.remove();
        loadMedia();
      } catch (e) {
        statusEl.textContent = "Upload failed: " + e.message;
        statusEl.style.color = "var(--danger)";
      } finally {
        uploadTrigger.disabled = false;
        uploadTrigger.textContent = "+ Upload Image";
      }

      fileInput.value = "";
    });

    searchInput.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => { currentPage = 1; loadMedia(); }, 300);
    });

    loadMedia();
  </script>
</AdminLayout>
