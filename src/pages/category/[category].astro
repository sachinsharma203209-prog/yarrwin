---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getEnv } from "../../lib/runtime";
import { getCategoryBySlug, listPostsByCategory } from "../../lib/db";

export const prerender = false;

const env = getEnv(Astro);
const categorySlug = Astro.params.category ?? "";
const category = await getCategoryBySlug(env.DB, categorySlug, { onlyActive: true });

if (!category) {
  return Astro.redirect("/404", 302);
}

const page = Number(Astro.url.searchParams.get("page") ?? "1") || 1;
const { posts, total } = await listPostsByCategory(env.DB, category.slug, { page });
const perPage = 12;
const totalPages = Math.max(1, Math.ceil(total / perPage));

const url = `https://yarrwin.online/category/${category.slug}/`;
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://yarrwin.online/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://yarrwin.online/blog/" },
    { "@type": "ListItem", position: 3, name: category.name, item: url },
  ],
};
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${category.name} — Yarrwin Blog`,
  description: category.description,
  url,
};
---

<BaseLayout
  title={`${category.name} — Yarrwin Blog`}
  description={category.description || `Latest articles about ${category.name} on Yarrwin.`}
  ogImage="/og/default.png"
  schema={[breadcrumb, collectionSchema]}
>
  <section class="section-pad">
    <div class="container-site">
      <SectionHeading
        eyebrow="Category"
        title={category.name}
        description={category.description || `Browse all posts about ${category.name}.`}
      />

      {posts.length === 0 ? (
        <p class="mt-12 text-center text-mist-500">No published posts in this category yet.</p>
      ) : (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="glass group flex flex-col overflow-hidden rounded-2xl p-0 transition duration-200 hover:-translate-y-1"
            >
              <div class="h-44 w-full overflow-hidden bg-ink-800">
                {post.featured_image ? (
                  <img src={post.featured_image} alt={post.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="grid h-full w-full place-items-center text-4xl text-mist-600">📄</div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="mb-2 flex items-center gap-2 text-xs text-mist-400">
                  <span>{new Date(post.published_at ?? post.created_at).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</span>
                </div>
                <h3 class="text-lg font-bold text-mist-100 group-hover:text-brand-300">{post.title}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-mist-400">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      )}

      {totalPages > 1 && (
        <nav class="mt-12 flex items-center justify-center gap-3">
          {page > 1 && <a class="btn btn-ghost" href={`/category/${category.slug}/?page=${page - 1}`}>← Prev</a>}
          <span class="text-sm text-mist-400">Page {page} of {totalPages}</span>
          {page < totalPages && <a class="btn btn-ghost" href={`/category/${category.slug}/?page=${page + 1}`}>Next →</a>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
