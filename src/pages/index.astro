---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { getEnv } from "../lib/runtime";
import { listPosts, listCategories } from "../lib/db";

const env = getEnv(Astro);
const { posts } = await listPosts(env.DB, { onlyPublished: true, page: 1 });
const catResult = await listCategories(env.DB, { onlyActive: true });
const categories = catResult.categories;
const latestPosts = posts.slice(0, 3);

const homeFaqs = [
  {
    q: "What is Yarrwin?",
    a: "Yarrwin is an online gaming and lottery results platform that provides draw results, game guides and strategy articles. Users can browse WinGo colour prediction results, K3 dice lottery draws, 5D lottery outcomes and Aviator round history.",
  },
  {
    q: "How do I log in to Yarrwin?",
    a: "Open the official Yarrwin website in your browser, tap the Login button and enter your registered email or mobile number along with your password. If two-factor authentication is enabled you will also need to approve the second-factor prompt.",
  },
  {
    q: "Is Yarrwin free to use?",
    a: "Browsing draw results, reading game guides and checking the results archive on Yarrwin is completely free. Placing real-money bets requires a funded account on the actual game platform, which is separate from this informational site.",
  },
  {
    q: "What games are available on Yarrwin?",
    a: "Yarrwin covers several game categories including WinGo colour prediction, the K3 three-dice lottery, the five-digit 5D lottery and provably-fair Aviator rounds. Each game has its own rules page and strategy guide.",
  },
  {
    q: "Are Yarrwin hack claims real?",
    a: "No. Claims that promise guaranteed wins, modified APKs or secret cheat codes are scams designed to steal your credentials or install malware. Never share your OTP, password or install unofficial apps. Responsible play means accepting that every draw is random.",
  },
  {
    q: "How do I verify a Yarrwin gift code?",
    a: "Gift codes should only be redeemed through the official Yarrwin platform. If someone contacts you claiming to offer a special code, verify the source through your official account dashboard before entering it anywhere.",
  },
  {
    q: "What is Yarrwin Club?",
    a: "Yarrwin Club is a community feature within the platform where users can access exclusive updates and group activities. Information about club features is available through your official account settings.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const gameCards = [
  { name: "WinGo", desc: "60-second colour prediction with Green, Red and Violet markets", href: "/games/#wingo", icon: "🎯" },
  { name: "K3 Lottery", desc: "Three-dice lottery with Big/Small, Odd/Even and triple bets", href: "/games/#k3", icon: "🎲" },
  { name: "5D Lottery", desc: "Five-digit draw with sum markets and per-digit bets", href: "/games/#5d", icon: "🔢" },
  { name: "Aviator", desc: "Provably-fair crash game with auto cash-out controls", href: "/games/#aviator", icon: "✈" },
];
---

<BaseLayout
  title="Yarrwin Game, Login Help and Platform Guide — Online Gaming & Lottery"
  description="Yarrwin is an online gaming and lottery results platform. Check draw results, read game guides for WinGo, K3, 5D and Aviator, and learn how to log in safely."
  keywords="yarrwin, yarrwin login, yarrwin game, yarrwin game login, yarrwin lottery, yarrwin club, yarrwin gift code"
  schema={[faqSchema]}
>
  {/* ── Section 1: Header (built-in via BaseLayout) ── */}

  {/* ── Section 2: Hero ── */}
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-48 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full bg-brand-500/10 blur-[130px]" aria-hidden="true"></div>

    <div class="container-site relative pt-10 pb-16 md:pt-14 md:pb-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">Online Gaming & Lottery Guide</p>
        <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight text-mist-100 md:text-5xl lg:text-6xl">
          Yarrwin <span class="text-gradient-brand">Game, Login Help &amp; Platform Guide</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-mist-400">
          Your independent guide to the Yarrwin gaming platform. Check draw results for WinGo, K3 and 5D lotteries, learn safe login practices, and read strategy articles — all in one place.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/games/" class="btn btn-primary">Explore Games</a>
          <a href="/results/" class="btn btn-ghost">View Results</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Section 3: Navigation / Action Cards ── */}
  <section class="section-pad bg-ink-850/40">
    <div class="container-site">
      <SectionHeading
        eyebrow="Quick Access"
        title="Explore Yarrwin"
        description="Jump straight to the section you need."
      />
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/games/" class="glass rounded-3xl p-6 transition duration-200 hover:-translate-y-1 hover:border-brand-500/30">
          <span class="text-3xl">🎮</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Games Hub</h3>
          <p class="mt-2 text-sm text-mist-400">WinGo, K3, 5D and Aviator rules and odds.</p>
        </a>
        <a href="/results/" class="glass rounded-3xl p-6 transition duration-200 hover:-translate-y-1 hover:border-brand-500/30">
          <span class="text-3xl">📊</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Results Archive</h3>
          <p class="mt-2 text-sm text-mist-400">Historical draw tables for every game.</p>
        </a>
        <a href="/guide/how-to-play/" class="glass rounded-3xl p-6 transition duration-200 hover:-translate-y-1 hover:border-brand-500/30">
          <span class="text-3xl">📖</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Beginner Guide</h3>
          <p class="mt-2 text-sm text-mist-400">Step-by-step guide to safe, responsible play.</p>
        </a>
        <a href="/blog/" class="glass rounded-3xl p-6 transition duration-200 hover:-translate-y-1 hover:border-brand-500/30">
          <span class="text-3xl">📰</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Blog &amp; Guides</h3>
          <p class="mt-2 text-sm text-mist-400">Strategy articles and platform news.</p>
        </a>
      </div>
    </div>
  </section>

  {/* ── Section 4: Game Information ── */}
  <section class="section-pad">
    <div class="container-site">
      <SectionHeading
        eyebrow="Game Categories"
        title="Yarrwin Game Categories"
        description="Each game on the Yarrwin platform settles on a different cadence and market structure."
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {gameCards.map((game) => (
          <a href={game.href} class="glass group flex items-start gap-5 rounded-3xl p-6 transition duration-200 hover:-translate-y-1 hover:border-brand-500/30">
            <span class="text-4xl">{game.icon}</span>
            <div>
              <h3 class="font-display text-xl font-bold text-mist-100 group-hover:text-brand-300">{game.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mist-400">{game.desc}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-mist-500">
        Detailed rules, payout tables and strategy tips are available on the <a href="/games/" class="prose-link">Games Hub</a>.
      </p>
    </div>
  </section>

  {/* ── Section 5: Login Help ── */}
  <section id="login" class="section-pad bg-ink-850/40 scroll-mt-28">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">🔐 Safe Access</p>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight">How to Access Yarrwin Login Safely</h2>
        <p class="mt-5 leading-relaxed text-mist-300">
          Accessing your Yarrwin game login safely starts with verifying the URL in your browser. Always type the address directly or use a bookmarked link rather than following unsolicited messages or ads. Check for the padlock icon and confirm the domain matches the official Yarrwin website before entering any credentials.
        </p>
        <p class="mt-4 leading-relaxed text-mist-300">
          Once on the login page, enter your registered email or mobile number and your password. If two-factor authentication is enabled, approve the prompt through your authenticator app. Enable 2FA from your account dashboard as soon as possible — it adds a critical layer of protection to your Yarrwin login.
        </p>
        <p class="mt-4 leading-relaxed text-mist-300">
          Common login issues include entering the wrong password, not receiving the 2FA code, or accessing an outdated bookmark. If you are locked out, use the password reset flow and check your email for the recovery link. Clear your browser cache if the page does not load correctly.
        </p>
      </div>
      <div class="flex flex-col gap-4">
        <div class="glass rounded-3xl p-6">
          <h3 class="font-display text-base font-bold text-mist-100">Login Safety Checklist</h3>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-mist-300">
            <li class="flex gap-3">✓ Always use the official Yarrwin URL directly</li>
            <li class="flex gap-3">✓ Enable two-factor authentication</li>
            <li class="flex gap-3">✓ Never share your password or OTP codes</li>
            <li class="flex gap-3">✓ Log out after each session on shared devices</li>
            <li class="flex gap-3">✓ Report suspicious login alerts immediately</li>
          </ul>
        </div>
        <div class="glass rounded-3xl p-6">
          <h3 class="font-display text-base font-bold text-mist-100">Common Login Issues</h3>
          <p class="mt-3 text-sm leading-relaxed text-mist-400">
            Forgot your password? Use the reset link sent to your registered email. Not receiving 2FA codes? Check your authenticator app is synced. Still stuck? Contact Yarrwin support through your account dashboard.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Section 6: Lottery / Results ── */}
  <section id="lottery" class="section-pad scroll-mt-28">
    <div class="container-site">
      <SectionHeading
        eyebrow="Draw Results"
        title="Yarrwin Lottery and Results"
        description="Every draw period is published to the results archive with its full outcome."
      />
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="font-display text-xl font-bold text-mist-100">What the results archive shows</h3>
          <p class="mt-4 leading-relaxed text-mist-300">
            Yarrwin publishes the outcome of every draw period to a permanent, uneditable archive. WinGo periods settle every 60 seconds with a winning digit, its colour and its size. K3 draws three dice every three minutes and shows the sum, parity and size. 5D draws five digits every five minutes with the full A-E matrix and sum total.
          </p>
          <p class="mt-4 leading-relaxed text-mist-300">
            The archive is designed for transparency. You can verify any period from its archive row alone without relying on third-party sources. This makes it easy to cross-check results and understand the distribution of outcomes across any time range.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <a href="/results/" class="glass rounded-3xl p-6 transition duration-200 hover:-translate-y-1">
            <h4 class="font-display text-lg font-bold text-mist-100">View Live Results</h4>
            <p class="mt-2 text-sm text-mist-400">Open the full results archive with WinGo, K3 and 5D draw tables.</p>
          </a>
          <div class="glass rounded-3xl p-6">
            <h4 class="font-display text-lg font-bold text-mist-100">How results are published</h4>
            <p class="mt-2 text-sm leading-relaxed text-mist-400">
              Results are written to the archive within seconds of each period closing. Each row includes the period number, winning outcome, colour, size and UTC timestamp. The archive is append-only — rows are never edited after publication.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Section 7: Yarrwin Club ── */}
  <section id="club" class="section-pad bg-ink-850/40 scroll-mt-28">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">👥 Community</p>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight">What Is Yarrwin Club?</h2>
        <p class="mt-5 leading-relaxed text-mist-300">
          Yarrwin Club is a community feature within the platform designed to connect users with group activities and exclusive updates. Club members can access special announcements, participate in community events and stay informed about new game launches and feature updates.
        </p>
        <p class="mt-4 leading-relaxed text-mist-300">
          Information about Yarrwin Club features, membership tiers and available benefits is managed through your official account settings. If you have an active Yarrwin account, check the Club section in your dashboard for the latest details on what is currently available.
        </p>
      </div>
      <div class="glass rounded-3xl p-8">
        <h3 class="font-display text-lg font-bold text-mist-100">Club Features</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-mist-300">
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Community events and group activities</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Exclusive announcements and updates</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> New game launch notifications</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Feature preview access</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Dashboard-based membership management</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── Section 8: Gift Code Safety ── */}
  <section id="gift-code" class="section-pad scroll-mt-28">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">🎁 Gift Codes</p>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight">How to Verify a Yarrwin Gift Code</h2>
        <p class="mt-5 leading-relaxed text-mist-300">
          Yarrwin gift codes are promotional codes that may be distributed through official channels. If you receive a gift code, always verify that the source is genuinely from Yarrwin before entering it into any field. Legitimate codes are delivered through your official account, official notifications or verified partner channels.
        </p>
        <p class="mt-4 leading-relaxed text-mist-300">
          Be cautious of codes shared through social media comments, unsolicited messages or unofficial websites. These may be phishing attempts designed to capture your login credentials. A genuine Yarrwin gift code will be redeemable directly from your account dashboard — you should never need to visit a third-party site or provide your password to claim a code.
        </p>
      </div>
      <div class="glass rounded-3xl p-6">
        <h3 class="font-display text-base font-bold text-mist-100">Gift Code Safety Tips</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-mist-300">
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Only redeem codes through your official Yarrwin account</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Never enter gift codes on third-party websites</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Ignore unsolicited DMs offering "exclusive" codes</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Check the code source before clicking any redemption link</li>
          <li class="flex gap-3"><span class="text-brand-300 font-bold">•</span> Report suspicious code offers to Yarrwin support</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── Section 9: Hack Scam Warning ── */}
  <section id="scam-warning" class="section-pad bg-ink-850/40 scroll-mt-28">
    <div class="container-site">
      <SectionHeading
        eyebrow="⚠ Safety Warning"
        title="Are Yarrwin Hack Claims Real?"
        description="Protecting yourself from fake hack websites and modified applications."
      />
      <div class="mt-10 grid gap-8 lg:grid-cols-2">
        <div>
          <p class="leading-relaxed text-mist-300">
            No, Yarrwin hack claims are not real. Every website, video or message that promises guaranteed wins, "predictor" tools, modified APKs or secret cheat codes is a scam. These operations exist solely to steal your account credentials, install malware on your device or harvest your personal information.
          </p>
          <p class="mt-4 leading-relaxed text-mist-300">
            The Yarrwin platform uses provably fair mechanics, which means each draw outcome is determined by cryptographic commitments that cannot be altered after the fact. No external tool, script or "hack" can predict or manipulate the result of a draw that has already been committed. Anyone claiming otherwise is misleading you.
          </p>
          <p class="mt-4 leading-relaxed text-mist-300">
            Never install modified APKs from unofficial sources, never share your OTP or password with anyone, and never enter your Yarrwin login credentials on any site other than the official domain. If something claims to be a "Yarrwin hack" — it is a trap.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <div class="glass rounded-3xl p-6">
            <h3 class="font-display text-base font-bold text-mist-100">Red Flags to Watch For</h3>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed text-mist-300">
              <li class="flex gap-3"><span class="text-[#ff8a94] font-bold">✗</span> "Guaranteed win" promises</li>
              <li class="flex gap-3"><span class="text-[#ff8a94] font-bold">✗</span> Modified APK downloads</li>
              <li class="flex gap-3"><span class="text-[#ff8a94] font-bold">✗</span> Requesting your OTP or password</li>
              <li class="flex gap-3"><span class="text-[#ff8a94] font-bold">✗</span> Third-party "prediction" websites</li>
              <li class="flex gap-3"><span class="text-[#ff8a94] font-bold">✗</span> Unsolicited messages with links</li>
            </ul>
          </div>
          <div class="glass rounded-3xl p-6">
            <h3 class="font-display text-base font-bold text-mist-100">What to Do Instead</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist-400">
              Play responsibly using the official platform. Learn game mechanics through the <a href="/guide/how-to-play/" class="prose-link">Beginner Guide</a>, study the <a href="/games/" class="prose-link">Games Hub</a> for odds and payouts, and accept that every draw is random. There is no shortcut that beats fair odds.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Section 10: How Yarrwin Works ── */}
  <section id="how-it-works" class="section-pad scroll-mt-28">
    <div class="container-site">
      <SectionHeading
        eyebrow="Getting Started"
        title="How Yarrwin Works"
        description="A simple overview of the platform from account creation to placing your first game."
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="glass rounded-3xl p-6 text-center">
          <span class="text-3xl">①</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Register</h3>
          <p class="mt-2 text-sm text-mist-400">Create your account with a verified email and strong password.</p>
        </div>
        <div class="glass rounded-3xl p-6 text-center">
          <span class="text-3xl">②</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Secure</h3>
          <p class="mt-2 text-sm text-mist-400">Enable two-factor authentication from your dashboard settings.</p>
        </div>
        <div class="glass rounded-3xl p-6 text-center">
          <span class="text-3xl">③</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Explore</h3>
          <p class="mt-2 text-sm text-mist-400">Browse the games hub, read the rules and study the results archive.</p>
        </div>
        <div class="glass rounded-3xl p-6 text-center">
          <span class="text-3xl">④</span>
          <h3 class="mt-3 font-display text-lg font-bold text-mist-100">Play</h3>
          <p class="mt-2 text-sm text-mist-400">Fund your wallet and start with small stakes on markets you understand.</p>
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-mist-500">
        Read the full walkthrough in the <a href="/guide/how-to-play/" class="prose-link">Beginner Guide</a>.
      </p>
    </div>
  </section>

  {/* ── Section 11: Responsible Use ── */}
  <section id="responsible" class="section-pad bg-ink-850/40 scroll-mt-28">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">🛡 Responsible Gaming</p>
        <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight">Safety and Responsible Use</h2>
        <p class="mt-5 leading-relaxed text-mist-300">
          Yarrwin is an informational guide designed to help users understand online gaming platforms. Gaming involves financial risk and should be treated as entertainment, not a source of income. Set a budget before you play, keep stakes flat, and end sessions on schedule rather than on streaks.
        </p>
        <p class="mt-4 leading-relaxed text-mist-300">
          If gaming stops feeling like fun, use the platform's built-in tools: deposit limits, session reminders, cool-off periods and self-exclusion are all available from your dashboard. You do not need to contact support to activate any of them — they take effect immediately.
        </p>
      </div>
      <div class="glass rounded-3xl p-6">
        <h3 class="font-display text-base font-bold text-mist-100">The Four Rules of Safe Play</h3>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-mist-300">
          <li class="flex gap-3"><span class="text-brand-400 font-bold">✓</span> Budget a fixed amount per session — money whose loss changes nothing.</li>
          <li class="flex gap-3"><span class="text-brand-400 font-bold">✓</span> Never chase losses; a raised stake to recover is a decision made by the last draw, not by you.</li>
          <li class="flex gap-3"><span class="text-brand-400 font-bold">✓</span> Take scheduled breaks — the countdown timer runs fine without you.</li>
          <li class="flex gap-3"><span class="text-brand-400 font-bold">✓</span> 18+ only, always. Gaming is for adults who have checked their local laws.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ── Section 12: FAQ ── */}
  <section class="section-pad scroll-mt-28">
    <div class="container-site grid gap-10 lg:grid-cols-[0.9fr_1.4fr]">
      <SectionHeading
        eyebrow="FAQ"
        title="Frequently Asked Questions"
        sub="Quick answers to common questions about Yarrwin."
      />
      <FaqAccordion items={homeFaqs} />
    </div>
  </section>

  {/* ── Section 13: Latest Blog Posts ── */}
  {latestPosts.length > 0 && (
    <section class="section-pad bg-ink-850/40">
      <div class="container-site">
        <SectionHeading
          eyebrow="Latest"
          title="Latest Yarrwin Guides"
          description="Strategy articles, result updates and platform news from the blog."
        />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class="glass group flex flex-col overflow-hidden rounded-2xl p-0 transition duration-200 hover:-translate-y-1"
            >
              <div class="h-44 w-full overflow-hidden bg-ink-800">
                {post.featured_image ? (
                  <img src={post.featured_image} alt={post.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" width="400" height="176" />
                ) : (
                  <div class="grid h-full w-full place-items-center text-4xl text-mist-600">🎯</div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="mb-2 flex items-center gap-2 text-xs text-mist-400">
                  {post.category_slug && (
                    <span class="chip chip-green">{post.category_name}</span>
                  )}
                  <span>{new Date(post.published_at ?? post.created_at).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}</span>
                </div>
                <h3 class="text-lg font-bold text-mist-100 group-hover:text-brand-300">{post.title}</h3>
                <p class="mt-2 line-clamp-3 text-sm text-mist-400">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-10 text-center">
          <a href="/blog/" class="btn btn-ghost">View All Articles</a>
        </div>
      </div>
    </section>
  )}

  {/* ── Section 14: Footer (built-in via BaseLayout) ── */}
</BaseLayout>
